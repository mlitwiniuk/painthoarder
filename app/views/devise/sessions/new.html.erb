<% content_for :title, "Sign in · PaintHoarder" %>
<%= form_with model: resource, scope: resource_name, url: session_path(resource_name), class: "flex flex-col gap-5", data: { turbo: "false" } do |f| %>
  <%= render "devise/shared/heading", title: "Sign in",
        intro: safe_join(["New here? ", link_to("Create a free account", new_registration_path(resource_name), class: "text-accent-text font-semibold")]) %>

  <%= render "devise/shared/field", f: f, attribute: :login, label: "Username or email",
        input_html: { autofocus: true, autocomplete: "username" } %>

  <%= render "devise/shared/field", f: f, attribute: :password, label: "Password", type: :password_field,
        aside: (link_to("Forgot it?", new_password_path(resource_name), class: "font-medium text-muted hover:text-accent-text") if devise_mapping.recoverable?),
        input_html: { autocomplete: "current-password" } %>

  <% if devise_mapping.rememberable? %>
    <label class="flex items-center gap-2.5 text-[15px] min-h-11 cursor-pointer">
      <%= f.check_box :remember_me, class: "checkbox checkbox-primary" %>
      Keep me signed in on this device
    </label>
  <% end %>

  <%= f.submit "Sign in", class: "btn btn-primary btn-lg h-13 w-full" %>

  <%= render "devise/shared/links" %>
<% end %>
