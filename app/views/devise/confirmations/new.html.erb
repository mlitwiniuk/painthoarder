<% content_for :title, "Resend confirmation · PaintHoarder" %>
<%= form_with model: resource, scope: resource_name, url: confirmation_path(resource_name), method: :post, class: "flex flex-col gap-5", data: { turbo: "false" } do |f| %>
  <%= render "devise/shared/heading", title: "Resend confirmation",
        intro: "We'll send the confirmation link again." %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= render "devise/shared/field", f: f, attribute: :email, label: "Email", type: :email_field,
        input_html: { autofocus: true, autocomplete: "email", required: true,
                      value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) } %>
  <%= f.submit "Send it again", class: "btn btn-primary btn-lg h-13 w-full" %>
  <%= render "devise/shared/links" %>
<% end %>
