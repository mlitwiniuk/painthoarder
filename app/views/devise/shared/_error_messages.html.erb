<% if resource.errors.any? %>
  <div id="error_explanation" role="alert" data-turbo-cache="false"
       class="flex items-start gap-2.5 px-3.5 py-3 border-2 border-avoid rounded text-sm leading-snug">
    <%= ph_icon(:alert, size: 18, stroke: 2.4, css: "shrink-0 mt-px text-avoid") %>
    <span>
      <% if resource.errors.count == 1 %>
        Fix one thing below and you're in.
      <% else %>
        Fix <%= resource.errors.count %> things below and you're in.
      <% end %>
      <% base = resource.errors.full_messages_for(:base) %>
      <% if base.any? %><br><%= base.to_sentence %><% end %>
    </span>
  </div>
<% end %>
