<%# Cloudflare Turnstile widget. Locals: action (optional, shown in Turnstile analytics) %>
<div data-controller="turnstile"
     data-turnstile-site-key-value="<%= Turnstile.site_key %>"
     data-turnstile-action-value="<%= local_assigns[:action] %>"
     data-turbo-temporary
     class="min-h-[65px] text-sm text-avoid"></div>
<noscript><p class="text-sm text-avoid">JavaScript is required to pass the security check.</p></noscript>
