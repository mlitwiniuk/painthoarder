<% content_for :title, "Change password · PaintHoarder" %>
<% content_for :tagline, safe_join(["New key,", tag.br, "same rack."]) %>
<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :put, class: "flex flex-col gap-5", data: { turbo: "false" } do |f| %>
  <%= render "devise/shared/heading", title: "Change your password" %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :reset_password_token %>
  <%= render "devise/shared/field", f: f, attribute: :password, label: "New password", type: :password_field,
        hint: ("At least #{@minimum_password_length} characters" if @minimum_password_length),
        input_html: { autofocus: true, autocomplete: "new-password", required: true } %>
  <%= render "devise/shared/field", f: f, attribute: :password_confirmation, label: "Repeat new password", type: :password_field,
        input_html: { autocomplete: "new-password", required: true } %>
  <%= f.submit "Change my password", class: "btn btn-primary btn-lg h-13 w-full" %>
  <%= render "devise/shared/links" %>
<% end %>
