<% content_for :title, "Reset password · PaintHoarder" %>
<% content_for :tagline, safe_join(["Lost the", tag.br, "key?"]) %>
<%= form_with model: resource, scope: resource_name, url: password_path(resource_name), method: :post, class: "flex flex-col gap-5", data: { turbo: "false" } do |f| %>
  <%= render "devise/shared/heading", title: "Forgot your password?",
        intro: "We'll email you a link to set a new one." %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= render "devise/shared/field", f: f, attribute: :email, label: "Email", type: :email_field,
        input_html: { autofocus: true, autocomplete: "email", required: true } %>
  <%= f.submit "Send reset link", class: "btn btn-primary btn-lg h-13 w-full" %>
  <%= render "devise/shared/links" %>
<% end %>
