<% content_for :title, "Unlock account · PaintHoarder" %>
<%= form_with model: resource, scope: resource_name, url: unlock_path(resource_name), method: :post, class: "flex flex-col gap-5", data: { turbo: "false" } do |f| %>
  <%= render "devise/shared/heading", title: "Unlock your account",
        intro: "Too many wrong passwords. We'll email you an unlock link." %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= render "devise/shared/field", f: f, attribute: :email, label: "Email", type: :email_field,
        input_html: { autofocus: true, autocomplete: "email", required: true } %>
  <%= f.submit "Send unlock link", class: "btn btn-primary btn-lg h-13 w-full" %>
  <%= render "devise/shared/links" %>
<% end %>
