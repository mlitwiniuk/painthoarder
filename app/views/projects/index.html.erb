<% content_for :title, params[:action] == "public_index" ? "Community Projects" : "My Projects" %>
<% content_for :description, params[:action] == "public_index" ? "Discover amazing miniature painting projects from the PaintHoarder community. Get inspired by fellow painters' work, techniques, and creative ideas." : "Manage and showcase your miniature painting projects. Document your progress, share your hobby journey, and track your painting improvements." %>
<% render_og_tags(projects_index_og_tags(params[:action] == "public_index")) %>
<% render_structured_data(projects_index_structured_data(@projects, params[:action] == "public_index")) %>

<div class="min-h-screen bg-base-100">
  <!-- Mobile-first sticky header -->
  <div class="sticky top-0 z-30 bg-base-100/95 backdrop-blur-md border-b border-base-200">
    <div class="navbar px-4">
      <div class="navbar-start">
        <h1 class="text-xl font-bold">
          <%= params[:action] == "public_index" ? "Community" : "Projects" %>
        </h1>
      </div>

      <div class="navbar-center">
        <!-- Navigation Tabs -->
        <div class="tabs tabs-boxed bg-base-200">
          <% if user_signed_in? %>
          <%= link_to projects_path,
              class: "tab tab-sm #{params[:action] != 'public_index' ? 'tab-active' : ''}" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="hidden sm:inline">Mine</span>
          <% end %>
          <% end %>
          <%= link_to public_projects_path,
              class: "tab tab-sm #{params[:action] == 'public_index' ? 'tab-active' : ''}" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9" />
            </svg>
            <span class="hidden sm:inline">All</span>
          <% end %>
        </div>
      </div>

      <div class="navbar-end">
        <% if user_signed_in? %>
          <%= link_to new_project_path, class: "btn btn-primary btn-circle" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Main content area with max width for better readability -->
  <div class="max-w-2xl mx-auto">
    <% if @projects.any? %>
      <!-- Projects Feed -->
      <div class="divide-y divide-base-200">
        <% @projects.each do |project| %>
          <article class="bg-base-100 hover:bg-base-50 transition-colors">
            <!-- Project Header -->
            <div class="p-4 pb-0">
              <div class="flex items-start gap-3">
                <div class="avatar">
                  <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white font-medium shadow-md">
                    <%= gravatar_for project.user %>
                  </div>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="font-semibold text-base-content"><%= project.user.username || project.user.email.split('@').first %></h3>
                    <div class="badge badge-<%= project.visibility == 'public' ? 'success' : 'warning' %> badge-sm">
                      <%= project.visibility %>
                    </div>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-base-content/60 mb-2">
                    <time><%= time_ago_in_words(project.created_at) %> ago</time>
                    <span>•</span>
                    <span>
                      <%= pluralize(project.project_updates.count, 'update') %>
                      <% if project.project_updates.joins(:photos_attachments).count > 0 %>
                        • <%= project.project_updates.joins(:photos_attachments).count %> photos
                      <% end %>
                    </span>
                  </div>
                  <h4 class="text-lg font-bold text-base-content mb-1">
                    <%= link_to project.title, project.visibility == 'private' ? project_url(project) : restricted_project_url(project.secret_token), class: "hover:text-primary transition-colors" %>
                  </h4>
                  <% if project.description.present? %>
                    <div class="prose prose-sm max-w-none text-base-content/80 mb-3">
                      <%= simple_format(truncate(strip_tags(project.description), length: 120)) %>
                    </div>
                  <% end %>
                </div>

                <!-- Project Actions -->
                <% if user_signed_in? && current_user == project.user %>
                  <div class="dropdown dropdown-end">
                    <label tabindex="0" class="btn btn-ghost btn-circle btn-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                      </svg>
                    </label>
                    <ul tabindex="0" class="dropdown-content menu p-2 shadow-xl bg-base-100 rounded-box w-32 border border-base-200">
                      <li>
                        <%= link_to edit_project_path(project), class: "gap-2 text-sm" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                          </svg>
                          Edit
                        <% end %>
                      </li>
                      <li>
                        <%= link_to project, data: { turbo_method: :delete, turbo_confirm: "Delete this project?" }, class: "gap-2 text-sm text-error" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                          Delete
                        <% end %>
                      </li>
                    </ul>
                  </div>
                <% end %>
              </div>
            </div>

            <!-- Project Cover Image -->
            <% if project.cover_photo.attached? %>
              <div class="mt-3 cursor-pointer" onclick="window.location='<%= project.visibility == 'private' ? project_url(project) : restricted_project_url(project.secret_token) %>'">
                <div class="aspect-[4/3] w-full overflow-hidden">
                  <%= image_tag optimized_variant(project.cover_photo, :card),
                      class: "w-full h-full object-cover hover:brightness-95 transition-all" %>
                </div>
              </div>
            <% else %>
              <!-- Recent project update photos if no cover -->
              <% recent_photos = project.project_updates.joins(:photos_attachments).limit(3).flat_map(&:photos_attachments) %>
              <% if recent_photos.any? %>
                <div class="mt-3 cursor-pointer" onclick="window.location='<%= project.visibility == 'private' ? project_url(project) : restricted_project_url(project.secret_token) %>'">
                  <% if recent_photos.count == 1 %>
                    <div class="aspect-[4/3] w-full overflow-hidden">
                      <%= image_tag optimized_variant(recent_photos.first, :card),
                          class: "w-full h-full object-cover hover:brightness-95 transition-all" %>
                    </div>
                  <% elsif recent_photos.count == 2 %>
                    <div class="grid grid-cols-2 gap-1 aspect-[4/3] overflow-hidden">
                      <% recent_photos.take(2).each do |photo| %>
                        <%= image_tag optimized_variant(photo, :card),
                            class: "w-full h-full object-cover hover:brightness-95 transition-all" %>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="grid grid-cols-2 gap-1 aspect-[4/3] overflow-hidden">
                      <%= image_tag optimized_variant(recent_photos.first, :card),
                          class: "w-full h-full object-cover hover:brightness-95 transition-all" %>
                      <div class="grid grid-rows-2 gap-1">
                        <%= image_tag optimized_variant(recent_photos.second, :card),
                            class: "w-full h-full object-cover hover:brightness-95 transition-all" %>
                        <div class="relative">
                          <%= image_tag optimized_variant(recent_photos.third, :card),
                              class: "w-full h-full object-cover" %>
                          <% if recent_photos.count > 3 %>
                            <div class="absolute inset-0 bg-black/60 flex items-center justify-center hover:bg-black/70 transition-colors">
                              <span class="text-white font-bold text-lg">
                                +<%= recent_photos.count - 2 %>
                              </span>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <!-- Engagement Actions -->
            <div class="p-4 pt-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <!-- Future: Like button -->
                  <button class="hidden flex items-center gap-1 text-sm text-base-content/60 hover:text-error transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                    <span class="hidden sm:inline">Like</span>
                  </button>

                  <!-- Future: Comment button -->
                  <button class="hidden flex items-center gap-1 text-sm text-base-content/60 hover:text-info transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <span class="hidden sm:inline">Comment</span>
                  </button>

                  <!-- View Project -->
                  <%= link_to project.visibility == 'private' ? project_url(project) : restricted_project_url(project.secret_token), class: "flex items-center gap-1 text-sm text-base-content/60 hover:text-primary transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                    <span class="hidden sm:inline">View</span>
                  <% end %>
                </div>

                <!-- Share button -->
                <% if project.visibility != 'private' %>
                  <div data-controller='clipboard' data-clipboard-text-value="<%= restricted_project_url(project.secret_token) %>">
                    <button class="flex items-center gap-1 text-sm text-base-content/60 hover:text-primary transition-colors" data-action="click->clipboard#copy">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                      </svg>
                    </button>
                  </div>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16 px-4">
        <div class="max-w-sm mx-auto">
          <div class="mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-base-content mb-2">
            <%= params[:action] == "public_index" ? "No public projects yet" : "No projects yet" %>
          </h3>
          <p class="text-base-content/70 mb-6 text-sm">
            <%= params[:action] == "public_index" ?
                "Be the first to share your miniature painting projects!" :
                "Start documenting your miniature painting journey." %>
          </p>
          <% unless params[:action] == "public_index" %>
            <%= link_to new_project_path, class: "btn btn-primary" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Create Your First Project
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
