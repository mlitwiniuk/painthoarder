<% content_for :title, params[:action] == "public_index" ? "Community Projects" : "My Projects" %>

<!-- Hero Section -->
<div class="bg-gradient-to-r from-primary/10 to-secondary/10 rounded-box p-6 mb-8">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <h1 class="text-3xl md:text-4xl font-bold text-base-content mb-2">
        <%= params[:action] == "public_index" ? "Community Gallery" : "Your Projects" %>
      </h1>
      <p class="text-base-content/70 text-lg">
        <%= params[:action] == "public_index" ? "Discover amazing miniature painting projects from the community" : "Showcase your miniature painting journey" %>
      </p>
    </div>

    <div class="flex flex-col sm:flex-row gap-2 w-full md:w-auto">
      <%= link_to new_project_path, class: "btn btn-primary btn-lg gap-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Project
      <% end %>
    </div>
  </div>
</div>

<!-- Navigation Tabs -->
<div class="tabs tabs-boxed bg-base-200 mb-6 w-fit">
  <%= link_to projects_path,
      class: "tab #{params[:action] != 'public_index' ? 'tab-active' : ''}" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
    </svg>
    My Projects
  <% end %>
  <%= link_to public_projects_path,
      class: "tab #{params[:action] == 'public_index' ? 'tab-active' : ''}" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9" />
    </svg>
    Community
  <% end %>
</div>

<!-- Projects Grid -->
<% if @projects.any? %>
  <div id="projects" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    <% @projects.each do |project| %>
      <article class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 group">
        <!-- Project Image -->
        <figure class="relative overflow-hidden">
          <% if project.cover_photo.attached? %>
            <%= image_tag project.cover_photo.variant(resize_to_fill: [400, 300]),
                class: "w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" %>
          <% else %>
            <div class="w-full h-48 bg-gradient-to-br from-base-200 to-base-300 flex items-center justify-center">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          <% end %>

          <!-- Visibility badge -->
          <div class="absolute top-3 right-3">
            <span class="badge badge-<%= project.visibility == 'public' ? 'success' : 'warning' %> badge-sm">
              <%= project.visibility.capitalize %>
            </span>
          </div>

          <!-- Quick actions overlay -->
          <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-2">
            <%= link_to project_path(project), class: "btn btn-primary btn-sm" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            <% end %>
            <% if user_signed_in? && current_user == project.user %>
              <%= link_to edit_project_path(project), class: "btn btn-secondary btn-sm" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </figure>

        <!-- Project Info -->
        <div class="card-body p-4">
          <!-- Title and Description -->
          <div class="mb-3">
            <h3 class="card-title text-lg font-semibold text-base-content mb-1 line-clamp-2">
              <%= link_to project.title, project_path(project), class: "hover:text-primary transition-colors" %>
            </h3>
            <% if project.description.present? %>
              <p class="text-sm text-base-content/70 line-clamp-2">
                <%= truncate(strip_tags(project.description), length: 80) %>
              </p>
            <% end %>
          </div>

          <!-- User Info -->
          <div class="flex items-center gap-2 mb-3">
            <div class="avatar placeholder">
              <div class="bg-neutral text-neutral-content rounded-full w-8">
                <span class="text-xs"><%= project.user.email.first.upcase %></span>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-base-content truncate">
                <%= project.user.email.split('@').first %>
              </p>
              <p class="text-xs text-base-content/60">
                <%= time_ago_in_words(project.created_at) %> ago
              </p>
            </div>
          </div>

          <!-- Stats -->
          <div class="flex items-center justify-between text-xs text-base-content/60">
            <div class="flex items-center gap-3">
              <span class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                </svg>
                <%= pluralize(project.project_updates.count, 'update') %>
              </span>
              <% if project.project_updates.joins(:photos_attachments).count > 0 %>
                <span class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <%= project.project_updates.joins(:photos_attachments).count %> photos
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <!-- Empty State -->
  <div class="text-center py-16">
    <div class="max-w-md mx-auto">
      <div class="mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24 mx-auto text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
      </div>
      <h3 class="text-xl font-semibold text-base-content mb-2">
        <%= params[:action] == "public_index" ? "No public projects yet" : "No projects yet" %>
      </h3>
      <p class="text-base-content/70 mb-6">
        <%= params[:action] == "public_index" ?
            "Be the first to share your miniature painting projects with the community!" :
            "Start documenting your miniature painting journey by creating your first project." %>
      </p>
      <% unless params[:action] == "public_index" %>
        <%= link_to new_project_path, class: "btn btn-primary btn-lg gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Create Your First Project
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
