<% content_for :title, @project.title %>
<% content_for :description, @project.description.present? ? strip_tags(@project.description).truncate(160) : "#{@project.user.username || @project.user.email.split('@').first}'s miniature painting project: #{@project.title}. Discover amazing miniature painting techniques and progress updates." %>
<% render_og_tags(project_og_tags(@project)) %>
<% render_structured_data(project_structured_data(@project)) %>

<div class="min-h-screen bg-base-100">
  <!-- Mobile-first sticky header -->
  <div class="sticky top-0 z-40 bg-base-100/95 backdrop-blur-md border-b border-base-200">
    <div class="navbar px-4">
      <div class="navbar-start">
        <%= link_to @project.user == current_user ? projects_path : public_projects_path, class: "btn btn-ghost btn-circle" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
      </div>

      <div class="navbar-center">
        <h1 class="font-bold text-lg truncate max-w-48"><%= @project.title %></h1>
      </div>

      <div class="navbar-end">
        <% if user_signed_in? && current_user == @project.user %>
          <div class="dropdown dropdown-end">
            <label tabindex="0" class="btn btn-ghost btn-circle">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
              </svg>
            </label>
            <ul tabindex="0" class="dropdown-content menu p-2 shadow-xl bg-base-100 rounded-box w-48 border border-base-200">
              <li>
                <%= link_to edit_project_path(@project), class: "gap-2" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                  Edit Project
                <% end %>
              </li>
              <li>
                <%= link_to @project, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "gap-2 text-error" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  Delete Project
                <% end %>
              </li>
            </ul>
          </div>
        <% end %>
      </div>
    </div>
  </div>


    <!-- Project Header Card -->
    <div class="bg-base-100 border-b border-base-200">
      <!-- Cover Photo -->
      <% if @project.cover_photo.attached? %>
        <div class="aspect-[4/3] w-full overflow-hidden">
          <%= image_tag optimized_variant(@project.cover_photo, :cover),
              class: "w-full h-full object-cover" %>
        </div>
      <% end %>

      <!-- Project Info -->
      <div class="p-4 space-y-4">
        <!-- User info and project title -->
        <div class="flex items-start gap-3">
          <div class="avatar">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white font-medium shadow-md">
              <%= gravatar_for @project.user %>
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <h2 class="font-semibold text-base-content"><%= @project.user.username || @project.user.email.split('@').first %></h2>
              <div class="badge badge-<%= @project.visibility == 'public' ? 'success' : 'warning' %> badge-sm">
                <%= @project.visibility %>
              </div>
            </div>
            <h3 class="text-xl font-bold text-base-content mb-1"><%= @project.title %></h3>
            <time class="text-sm text-base-content/60">
              <%= @project.created_at.strftime("%B %d, %Y") %>
            </time>
          </div>
        </div>

        <!-- Description -->
        <% if @project.description.present? %>
          <div class="prose prose-sm max-w-none text-base-content">
            <%= simple_format(@project.description) %>
          </div>
        <% end %>

        <!-- Project Stats -->
        <div class="flex items-center gap-6 text-sm text-base-content/70">
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            <%= pluralize(@project.project_updates.count, 'update') %>
          </span>
          <span class="flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <%= @project.project_updates.joins(:photos_attachments).count %> photos
          </span>
        </div>

        <!-- Action Buttons -->
        <% if user_signed_in? && current_user == @project.user %>
          <div class="flex gap-2">
            <%= link_to new_project_project_update_path(@project),
                class: "btn btn-primary flex-1",
                data: { turbo_frame: "modal" } do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add Update
            <% end %>

            <!-- Share Button -->
            <% if @project.visibility != 'private' %>
              <div data-controller='clipboard' data-clipboard-text-value="<%= restricted_project_url(@project.secret_token) %>">
                <button class="btn btn-outline" data-action="click->clipboard#copy">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                  </svg>
                </button>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Updates Feed -->
    <div class="divide-y divide-base-200">
      <% if @project.project_updates.any? %>
        <% @project.project_updates.includes(:user_paints, photos_attachments: :blob).reorder(position: :desc).each_with_index do |update, index| %>
          <article class="bg-base-100 p-4 hover:bg-base-50 transition-colors">
            <!-- Update Header -->
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <div class="avatar">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-white text-sm font-medium">
                    <%= gravatar_for @project.user %>
                  </div>
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-semibold text-base-content"><%= @project.user.username || @project.user.email.split('@').first %></span>
                    <% if index == 0 %>
                      <div class="badge badge-accent badge-xs">Latest</div>
                    <% end %>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-base-content/60">
                    <time><%= time_ago_in_words(update.created_at) %> ago</time>
                    <% if update.title.present? %>
                      <span>•</span>
                      <span class="font-medium"><%= update.title %></span>
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Update Actions -->
              <% if user_signed_in? && current_user == @project.user %>
                <div class="dropdown dropdown-end">
                  <label tabindex="0" class="btn btn-ghost btn-circle btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                    </svg>
                  </label>
                  <ul tabindex="0" class="dropdown-content menu p-2 shadow-xl bg-base-100 rounded-box w-32 border border-base-200">
                    <li>
                      <%= link_to edit_project_project_update_path(@project, update),
                          class: "gap-2 text-sm",
                          data: { turbo_frame: "modal" } do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Edit
                      <% end %>
                    </li>
                    <li>
                      <%= link_to project_project_update_path(@project, update),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Delete this update?"
                          },
                          class: "gap-2 text-sm text-error" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Delete
                      <% end %>
                    </li>
                  </ul>
                </div>
              <% end %>
            </div>

            <!-- Update Description -->
            <% if update.description.present? %>
              <div class="prose prose-sm max-w-none text-base-content mb-3 ml-13">
                <%= simple_format(update.description) %>
              </div>
            <% end %>

            <!-- Photos -->
            <% photos = update.photos_attachments %>
            <% if photos.any? %>
              <div data-controller="lightbox" class="mb-3 ml-13">
                <% if photos.count == 1 %>
                  <!-- Single photo -->
                  <div class="rounded-lg overflow-hidden cursor-pointer group max-w-md">
                    <%= image_tag optimized_variant(photos.first, :medium),
                        class: "w-full object-cover group-hover:brightness-95 transition-all",
                        data: {
                          lightbox_target: "thumbnail",
                          action: "click->lightbox#open",
                          full_url: url_for(optimized_variant(photos.first, :large))
                        } %>
                  </div>
                <% elsif photos.count == 2 %>
                  <!-- Two photos side by side -->
                  <div class="grid grid-cols-2 gap-1 rounded-lg overflow-hidden max-w-md">
                    <% photos.each do |photo| %>
                      <div class="cursor-pointer group aspect-square">
                        <%= image_tag optimized_variant(photo, :thumb),
                            class: "w-full h-full object-cover group-hover:brightness-95 transition-all",
                            data: {
                              lightbox_target: "thumbnail",
                              action: "click->lightbox#open",
                              full_url: url_for(optimized_variant(photo, :large))
                            } %>
                      </div>
                    <% end %>
                  </div>
                <% elsif photos.count == 3 %>
                  <!-- Three photos: one large, two small -->
                  <div class="grid grid-cols-2 gap-1 rounded-lg overflow-hidden max-w-md aspect-[4/3]">
                    <div class="cursor-pointer group">
                      <%= image_tag optimized_variant(photos.first, :thumb),
                          class: "w-full h-full object-cover group-hover:brightness-95 transition-all",
                          data: {
                            lightbox_target: "thumbnail",
                            action: "click->lightbox#open",
                            full_url: url_for(optimized_variant(photos.first, :large))
                          } %>
                    </div>
                    <div class="grid grid-rows-2 gap-1">
                      <% photos[1..2].each do |photo| %>
                        <div class="cursor-pointer group">
                          <%= image_tag optimized_variant(photo, :thumb),
                              class: "w-full h-full object-cover group-hover:brightness-95 transition-all",
                              data: {
                                lightbox_target: "thumbnail",
                                action: "click->lightbox#open",
                                full_url: url_for(optimized_variant(photo, :large))
                              } %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <!-- Four or more photos: show first 3 + overlay -->
                  <div class="grid grid-cols-2 gap-1 rounded-lg overflow-hidden max-w-md aspect-[4/3]">
                    <div class="cursor-pointer group">
                      <%= image_tag optimized_variant(photos[0], :thumb),
                          class: "w-full h-full object-cover group-hover:brightness-95 transition-all",
                          data: {
                            lightbox_target: "thumbnail",
                            action: "click->lightbox#open",
                            full_url: url_for(optimized_variant(photos.first, :large))
                          } %>
                    </div>
                    <div class="grid grid-rows-2 gap-1">
                      <div class="cursor-pointer group">
                        <%= image_tag optimized_variant(photos[1], :thumb),
                            class: "w-full h-full object-cover group-hover:brightness-95 transition-all",
                            data: {
                              lightbox_target: "thumbnail",
                              action: "click->lightbox#open",
                              full_url: url_for(optimized_variant(photos[1], :large))
                            } %>
                      </div>
                      <div class="relative cursor-pointer group">
                        <%= image_tag optimized_variant(photos[2], :thumb),
                            class: "w-full h-full object-cover",
                            data: {
                              lightbox_target: "thumbnail",
                              action: "click->lightbox#open",
                              full_url: url_for(optimized_variant(photos[2], :large))
                            } %>
                        <div class="absolute inset-0 bg-black/60 flex items-center justify-center group-hover:bg-black/70 transition-colors">
                          <span class="text-white font-bold text-lg">
                            +<%= photos.count - 2 %>
                          </span>
                            <% if photos.size > 4 %>
                              <% photos[3..-1].each do |photo| %>
                                <%= image_tag optimized_variant(photo, :thumb),
                                    class: "hidden",
                                    data: {
                                      lightbox_target: "thumbnail",
                                      action: "click->lightbox#open",
                                      full_url: url_for(optimized_variant(photo, :large))
                                    } %>
                              <% end %>
                            <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>

            <!-- Paints Used -->
            <% if update.user_paints.any? %>
              <div class="mb-3 ml-13">
                <div class="space-y-2">
                  <h4 class="text-sm font-medium text-base-content/70 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a4 4 0 004-4V5z" />
                    </svg>
                    Paints Used (<%= update.user_paints.count %>)
                  </h4>

                  <div class="space-y-1 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
                    <% update.user_paints.each do |user_paint| %>
                      <%= render 'paints/minimal_project_card', user_paint: user_paint %>
                    <% end %>

                  </div>
                </div>
              </div>
            <% end %>

            <!-- Engagement Actions -->
            <div class="hidden flex items-center justify-between ml-13">
              <div class="flex items-center gap-4">
                <!-- Future: Like button -->
                <button class="flex items-center gap-1 text-sm text-base-content/60 hover:text-error transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                  <span class="hidden sm:inline">Like</span>
                </button>

                <!-- Future: Comment button -->
                <button class="flex items-center gap-1 text-sm text-base-content/60 hover:text-info transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                  <span class="hidden sm:inline">Comment</span>
                </button>
              </div>

              <!-- Share button -->
              <button class="flex items-center gap-1 text-sm text-base-content/60 hover:text-primary transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                </svg>
              </button>
            </div>
          </article>
        <% end %>
      <% else %>
        <!-- Empty state -->
        <div class="text-center py-16 px-4">
          <div class="max-w-sm mx-auto">
            <div class="mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-base-content mb-2">No updates yet</h3>
            <p class="text-base-content/70 mb-6 text-sm">
              Start documenting your progress by adding your first update with photos and details.
            </p>
            <% if user_signed_in? && current_user == @project.user %>
              <%= link_to new_project_project_update_path(@project),
                  class: "btn btn-primary",
                  data: { turbo_frame: "modal" } do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add First Update
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

<!-- Modal Frame -->
<%= turbo_frame_tag "modal" %>

<style>
  .ml-13 {
    margin-left: 3.25rem; /* 52px - to align with content after avatar */
  }
</style>
