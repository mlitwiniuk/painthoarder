<!DOCTYPE html>
<html lang="en" class="scrollbar-rounded" data-theme="painthoarder">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="min-h-screen flex flex-col bg-page text-base-content <%= 'pb-20 lg:pb-0' if user_signed_in? %>">
    <header class="sticky top-0 z-40 bg-page border-b-2 border-line">
      <div class="wrap flex flex-wrap items-center justify-between gap-4 min-h-[68px]">
        <div class="flex items-center gap-7 flex-wrap">
          <%= link_to (user_signed_in? ? user_root_path : root_path), class: "cond flex items-center gap-2.5 font-black text-2xl no-underline" do %>
            <%= brand_mark(size: 22) %>Painthoarder
          <% end %>

          <nav aria-label="Main" class="hidden lg:flex gap-0.5">
            <% if user_signed_in? %>
              <%= link_to "My rack", user_paints_path, class: "nav-link", aria: {current: nav_current(:rack)} %>
            <% end %>
            <%= link_to "Catalogue", paints_path, class: "nav-link", aria: {current: nav_current(:catalogue)} %>
            <%= link_to "Projects", public_projects_path, class: "nav-link", aria: {current: nav_current(:projects)} %>
            <%= link_to "Videos", public_videos_path, class: "nav-link", aria: {current: nav_current(:videos)} %>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <% if user_signed_in? %>
            <%= form_with url: paints_path, method: :get, class: "hidden md:block", data: {controller: "search-hotkey", turbo_frame: "_top"} do %>
              <label class="flex items-center gap-2 h-10 w-56 px-2.5 border-2 border-line rounded bg-base-100 focus-within:border-base-content">
                <%= ph_icon(:search, size: 16, stroke: 2, css: "text-muted") %>
                <span class="sr-only">Search all paints</span>
                <%= search_field_tag :search, params[:search], placeholder: "Search paints", autocomplete: "off",
                      class: "w-full bg-transparent border-0 outline-none text-sm",
                      data: {search_hotkey_target: "input"} %>
                <kbd class="font-mono text-[11px] text-muted border border-line-strong rounded-[3px] px-1.5">/</kbd>
              </label>
            <% end %>

            <div class="dropdown dropdown-end" data-controller="theme">
              <div tabindex="0" role="button" aria-label="Account and settings"
                   class="w-10 h-10 rounded border-2 border-base-content bg-[#D2A285] text-[#141216] font-extrabold flex items-center justify-center cursor-pointer">
                <%= user_initial(current_user) %>
              </div>
              <ul tabindex="0" class="dropdown-content menu z-50 mt-3 w-60 p-2 panel">
                <li class="menu-title text-muted normal-case font-normal truncate"><%= current_user.email %></li>
                <li><%= link_to "Dashboard", user_root_path %></li>
                <li><%= link_to "Import paints", bulk_import_user_paints_path %></li>
                <li><%= link_to "Colour wheel", color_wheel_user_paints_path %></li>
                <li><%= link_to "My projects", projects_path %></li>
                <li><%= link_to "Account settings", edit_user_registration_path %></li>
                <% if current_user.admin? %>
                  <li><%= link_to "Producer catalog updates", admin_paint_catalog_runs_path %></li>
                <% end %>
                <li><button type="button" data-action="theme#toggle">Switch light / dark</button></li>
                <li><%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "w-full text-left" %></li>
              </ul>
            </div>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "cond font-extrabold text-[17px] tracking-[.03em] px-2.5 py-3 no-underline hover:text-accent-text" %>
            <%= link_to "Join free", new_user_registration_path, class: "btn btn-primary btn-sm" %>
          <% end %>
        </div>
      </div>
    </header>

    <div class="fixed top-20 right-4 z-50 max-w-md space-y-2" id="flash-messages">
      <% flash.each do |type, message| %>
        <% next unless message.is_a?(String) %>
        <div role="<%= type.to_s == 'notice' ? 'status' : 'alert' %>"
             class="panel flex items-start gap-3 px-4 py-3 <%= type.to_s == 'notice' ? 'border-base-content' : 'border-avoid' %>">
          <%= ph_icon(type.to_s == "notice" ? :check : :alert, size: 18, stroke: 2.4, css: "shrink-0 mt-0.5 #{type.to_s == 'notice' ? '' : 'text-avoid'}") %>
          <p class="flex-1 text-sm font-medium"><%= message %></p>
          <button type="button" aria-label="Dismiss" class="shrink-0 opacity-70 hover:opacity-100" onclick="this.parentElement.remove()">
            <%= ph_icon(:x, size: 16) %>
          </button>
        </div>
      <% end %>
    </div>

    <main class="flex-grow">
      <%= yield(:hero) if content_for?(:hero) %>
      <% if content_for?(:bare) %>
        <%= yield %>
      <% else %>
        <div class="wrap pt-8 md:pt-10 pb-16">
          <%= yield %>
        </div>
      <% end %>
    </main>

    <turbo-frame id="modal"></turbo-frame>

    <%= render "shared/lightbox_modal" %>

    <% if user_signed_in? %>
      <nav aria-label="Main" class="tabbar lg:hidden">
        <%= link_to user_paints_path, aria: {current: nav_current(:rack)} do %><%= ph_icon(:rack, size: 22) %>Rack<% end %>
        <%= link_to paints_path, aria: {current: nav_current(:catalogue)} do %><%= ph_icon(:search, size: 22) %>Catalogue<% end %>
        <%= link_to public_projects_path, aria: {current: nav_current(:projects)} do %><%= ph_icon(:projects, size: 22) %>Projects<% end %>
        <%= link_to public_videos_path, aria: {current: nav_current(:videos)} do %><%= ph_icon(:videos, size: 22) %>Videos<% end %>
        <%= link_to user_root_path, aria: {current: nav_current(:dashboard) || nav_current(:account)} do %><%= ph_icon(:account, size: 22) %>Account<% end %>
      </nav>
    <% else %>
      <footer class="border-t-2 border-line">
        <div class="wrap pt-7 pb-9 flex flex-wrap justify-between gap-4 text-sm text-muted">
          <span>PaintHoarder · made by a painter with too many pots · © <%= Date.current.year %> <a href="https://prograils.com" class="underline hover:text-base-content">Prograils</a></span>
          <nav aria-label="Footer" class="flex flex-wrap gap-5" data-controller="theme">
            <%= link_to "Brands", brands_path, class: "hover:text-base-content" %>
            <a href="https://github.com/mlitwiniuk/painthoarder" class="hover:text-base-content">GitHub</a>
            <%= link_to "Privacy", page_path("privacy-policy"), class: "hover:text-base-content" %>
            <%= link_to "Terms", page_path("terms-of-service"), class: "hover:text-base-content" %>
            <button type="button" class="underline hover:text-base-content" data-action="theme#toggle">Light / dark</button>
          </nav>
        </div>
      </footer>
    <% end %>

    <%= render "layouts/analytics" %>
  </body>
</html>
