<!DOCTYPE html>
<html lang="en" class="scrollbar-rounded compact" data-theme="painthoarder">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="min-h-screen flex flex-col bg-base-50 drawer drawer-end compact">
    <input id="my-drawer" type="checkbox" class="drawer-toggle" />

    <!-- Modern Header -->
    <header class="sticky top-0 z-40 backdrop-blur-xl border-b border-base-300">
      <div class="max-w-7xl mx-auto px-4 py-3">
        <nav class="flex justify-between items-center">
          <!-- Logo -->
          <div class="flex items-center">
            <%= link_to root_path, class: "flex items-center gap-3 group" do %>
              <div class="w-10 h-10 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center shadow-sm group-hover:shadow-md transition-shadow">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              </div>
              <span class="text-2xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                PaintHoarder
              </span>
            <% end %>
          </div>

          <% if user_signed_in? %>
            <!-- Desktop Navigation -->
            <div class="hidden lg:flex items-center gap-1 bg-base-200 rounded-full p-1">
              <%= link_to user_paints_path,
                  class: "px-6 py-2 rounded-full text-sm font-semibold transition-all #{current_page?(user_paints_path) ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-300'}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                My Collection
              <% end %>
              <%= link_to user_root_path,
                  class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{current_page?(user_root_path) ? 'bg-base-100 text-base-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
                Dashboard
              <% end %>
              <%= link_to paints_path,
                  class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{current_page?(paints_path) ? 'bg-base-100 text-base-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
                Explore
              <% end %>
              <%= link_to public_projects_path,
                  class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{current_page?(public_projects_path) ? 'bg-base-100 text-base-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
                Gallery
              <% end %>
            </div>

            <!-- Right Side Actions -->
            <div class="flex items-center gap-3">
              <!-- Theme Switcher -->
              <label for="my-drawer" class="btn btn-ghost btn-circle btn-sm hover:bg-base-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </label>

              <!-- Mobile Menu -->
              <div class="dropdown dropdown-end lg:hidden">
                <label tabindex="0" class="btn btn-ghost btn-circle btn-sm hover:bg-base-200">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
                  </svg>
                </label>
                <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-50 p-2 shadow-xl bg-base-100 rounded-xl w-52 border border-base-300">
                  <li><%= link_to "My Collection", user_paints_path, class: "text-base-content hover:bg-base-200 font-semibold" %></li>
                  <li><%= link_to "Dashboard", user_root_path, class: "text-base-content/70 hover:bg-base-200" %></li>
                  <li><%= link_to "Explore", paints_path, class: "text-base-content/70 hover:bg-base-200" %></li>
                  <li><%= link_to "Gallery", public_projects_path, class: "text-base-content/70 hover:bg-base-200" %></li>
                  <li><%= link_to "Bulk Import", bulk_import_user_paints_path, class: "text-base-content/70 hover:bg-base-200" %></li>
                </ul>
              </div>

              <!-- User Avatar -->
              <div class="dropdown dropdown-end">
                <label tabindex="0" class="btn btn-ghost btn-circle avatar hover:bg-base-200">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-primary to-secondary flex items-center justify-center text-primary-content text-sm font-medium shadow-sm">
                    <%= gravatar_for current_user %>
                  </div>
                </label>
                <ul tabindex="0" class="mt-3 z-40 p-2 shadow-xl menu menu-compact dropdown-content bg-base-100 rounded-xl w-52 border border-base-300">
                  <li class="px-4 py-2 text-sm text-base-content/50 border-b border-base-300">
                    <%= current_user.email %>
                  </li>
                  <li><%= button_to "Sign Out", destroy_user_session_path, method: :delete, class: "text-base-content/70 hover:bg-base-200 w-full text-left" %></li>
                </ul>
              </div>
            </div>
          <% else %>
            <!-- Guest Navigation -->
            <div class="flex items-center gap-3">
              <label for="my-drawer" class="btn btn-ghost btn-circle btn-sm hover:bg-base-200">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
              </label>
              <%= link_to "Gallery", public_projects_path, class: "btn btn-ghost btn-sm text-base-content/60 hover:text-base-content" %>
              <%= link_to "Sign In", new_user_session_path, class: "btn btn-ghost btn-sm text-base-content/60 hover:text-base-content" %>
              <%= link_to "Get Started", new_user_registration_path, class: "btn btn-primary btn-sm shadow-sm" %>
            </div>
          <% end %>
        </nav>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if flash.any? %>
      <div class="fixed top-20 right-4 z-50 max-w-md space-y-2" id="flash-messages">
        <% flash.each do |type, message| %>
          <div class="alert <%= type == 'notice' ? 'alert-success' : 'alert-error' %> shadow-lg rounded-xl p-4 flex items-start gap-3">
            <div class="flex-shrink-0">
              <% if type == 'notice' %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              <% end %>
            </div>
            <div class="flex-1">
              <p class="text-sm font-medium"><%= message %></p>
            </div>
            <button type="button" class="flex-shrink-0 ml-2 opacity-60 hover:opacity-100 transition-opacity" onclick="this.parentElement.remove()">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="flex-grow drawer-content">
      <div class="min-h-screen">
        <%= yield(:hero) if content_for?(:hero) %>
        <div class="max-w-7xl mx-auto p-4">
          <%= yield %>
        </div>
      </div>
    </main>

    <!-- Modal Container -->
    <turbo-frame id="modal"></turbo-frame>

    <!-- Modern Footer for Guests -->
    <% unless user_signed_in? %>
      <footer class="bg-base-100 border-t border-base-300">
        <div class="max-w-7xl mx-auto px-4 py-12">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="col-span-1 md:col-span-2">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                  </svg>
                </div>
                <span class="text-2xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
                  PaintHoarder
                </span>
              </div>
              <p class="text-base-content/60 mb-6 max-w-md">
                The ultimate tool for miniature painters to organize, discover, and share their paint collections with the community.
              </p>
              <div class="flex gap-4">
                <a href="https://github.com/mlitwiniuk/painthoarder" target="_blank" class="w-10 h-10 bg-base-200 hover:bg-base-300 rounded-full flex items-center justify-center transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
                  </svg>
                </a>
              </div>
            </div>

            <div>
              <h3 class="font-semibold text-base-content mb-4">Features</h3>
              <ul class="space-y-2 text-base-content/60">
                <li><a href="#" class="hover:text-base-content transition-colors">Collection Management</a></li>
                <li><a href="#" class="hover:text-base-content transition-colors">Color Matching</a></li>
                <li><a href="#" class="hover:text-base-content transition-colors">Wishlist Tracking</a></li>
                <li><a href="#" class="hover:text-base-content transition-colors">Community Sharing</a></li>
              </ul>
            </div>

            <div>
              <h3 class="font-semibold text-base-content mb-4">Company</h3>
              <ul class="space-y-2 text-base-content/60">
                <li>
                  <%= link_to "Privacy Policy", page_path("privacy-policy"), class: "hover:text-base-content transition-colors" %>
                </li>
                <li>
                  <%= link_to "Terms of Service", page_path("terms-of-service"), class: "hover:text-base-content transition-colors" %>
                </li>
              </ul>
            </div>
          </div>

          <div class="border-t border-base-300 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="text-sm text-base-content/50">
              © <%= Date.current.year %> PaintHoarder. All rights reserved.
            </div>
            <div class="text-sm text-base-content/50">
              ❤️ Crafted with love by <a href="https://prograils.com" class="hover:text-base-content/70 transition-colors">Prograils.com</a> team • Made in EU 🇪🇺
            </div>
          </div>
        </div>
      </footer>
    <% end %>

    <%= render "shared/theme_drawer" %>

    <%= render "layouts/analytics" %>
  </body>
</html>
