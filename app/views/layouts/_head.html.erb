<title><%= content_for(:title) || "PaintHoarder - Share & Track Your Miniature Painting Projects" %></title>
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no viewport-fit=cover">
<meta name="description" content="<%= content_for(:description) || "PaintHoarder: Share your miniature painting projects and manage your paint collection. Track paints, document progress, and connect with fellow painters in the ultimate hobby platform for Warhammer, D&D, and miniature enthusiasts." %>">
<meta name="keywords" content="miniature painting projects, share painting progress, Warhammer paint collection, miniature paint tracker, painting project gallery, hobby community, paint inventory app, miniature painting organizer, Citadel paint tracker, paint collection database, D&D miniature painting, Age of Sigmar painting, Warhammer 40k painting, miniature hobby social, paint collection manager, model painting techniques, hobby paint vault, miniature painting app, painting project documentation">
<meta name="author" content="PaintHoarder Team">
<meta name="robots" content="index, follow">
<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
<meta name="theme-color" content="#6366f1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="PaintHoarder">
<meta name="view-transition" content="same-origin" />
<meta name="turbo-prefetch" content="false">
<link rel="canonical" href="<%= request.original_url %>">
<meta property="og:locale" content="en_US">
<meta name="format-detection" content="telephone=no">
<meta name="msapplication-TileColor" content="#6366f1">
<meta name="msapplication-config" content="/browserconfig.xml">
<meta name="application-name" content="PaintHoarder">
<meta name="msapplication-tooltip" content="Share & Track Your Miniature Painting Projects">
<meta name="twitter:creator" content="@painthoarder">
<meta name="twitter:domain" content="<%= request.host %>">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<%= action_cable_meta_tag%>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag "application-main", "data-turbo-track": "reload" %>
<%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
<%= yield :head %>
<!-- Site-wide structured data for SEO -->
<script type="application/ld+json">
<%= raw organization_structured_data.to_json %>
</script>
<script type="application/ld+json">
<%= raw website_structured_data.to_json %>
</script>
<!-- <link rel="manifest" href="/manifest.json"> -->
<link rel="icon" href="/icon.png" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">
<script>
  document.documentElement.setAttribute('data-theme', window.localStorage.getItem('theme'))
</script>
