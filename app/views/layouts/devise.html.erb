<!DOCTYPE html>
<html lang="en" class="scrollbar-rounded" data-theme="painthoarder">
  <head>
    <%= render "layouts/head" %>
  </head>
  <body class="min-h-screen bg-page text-base-content">
    <div class="min-h-screen flex flex-wrap">
      <aside class="hidden min-[760px]:flex flex-[1_1_440px] flex-col <%= content_for?(:side) ? "gap-14" : "justify-between gap-10" %> px-12 py-10 bg-base-100 border-r-2 border-line">
        <%= link_to root_path, class: "cond flex items-center gap-2.5 font-black text-[26px] no-underline self-start" do %>
          <%= brand_mark(size: 24) %>Painthoarder
        <% end %>

        <% if content_for?(:side) %>
          <%= yield :side %>
        <% else %>
          <div class="flex flex-col gap-6">
            <div class="grid grid-cols-8 gap-1.5 items-end" aria-hidden="true">
              <% [["#9A1115", 180], ["#1F3A5A", 130], ["#A07D3B", 210], ["#DBD1B2", 150],
                  ["#3E6B3A", 190], ["#D9762B", 120], ["#5E6466", 200], ["#4B2E5C", 160]].each do |hex, height| %>
                <div class="rounded-t-[3px]" style="height: <%= height %>px; background: <%= hex %>"></div>
              <% end %>
            </div>
            <p class="cond font-black text-5xl leading-[.9]"><%= content_for?(:tagline) ? yield(:tagline) : safe_join(["Back to", tag.br, "the rack."]) %></p>
          </div>
        <% end %>

        <% unless content_for?(:side) %>
          <span class="font-mono text-xs text-muted">// YOUR PAINTS MISSED YOU. PROBABLY.</span>
        <% end %>
      </aside>

      <main class="flex-[1_1_480px] px-4 sm:px-8 py-10 flex flex-col items-center justify-center gap-8">
        <%= link_to root_path, class: "min-[760px]:hidden cond flex items-center gap-2.5 font-black text-2xl no-underline self-start" do %>
          <%= brand_mark(size: 22) %>Painthoarder
        <% end %>

        <div class="w-full max-w-[400px] flex flex-col gap-5">
          <% flash.each do |type, message| %>
            <% next unless message.is_a?(String) %>
            <% notice = type.to_s == "notice" %>
            <div role="<%= notice ? 'status' : 'alert' %>"
                 class="flex items-start gap-2.5 px-3.5 py-3 border-2 rounded text-sm leading-snug <%= notice ? 'border-base-content' : 'border-avoid' %>">
              <%= ph_icon(notice ? :check : :alert, size: 18, stroke: 2.4, css: "shrink-0 mt-px #{'text-avoid' unless notice}") %>
              <span><%= message %></span>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
    <%= render "layouts/analytics" %>
  </body>
</html>
