<% content_for :title, "Dashboard" %>
<% greeting = case Time.current.hour
               when 5..11 then "Morning"
               when 12..17 then "Afternoon"
               else "Evening"
               end %>

<div class="flex flex-col gap-8">
  <div class="flex flex-wrap justify-between items-end gap-5">
    <div class="flex flex-col gap-2.5">
      <h1 class="page-title"><%= greeting %>, <%= current_user.name %></h1>
      <p class="eyebrow text-[13px]">
        <%= @owned_paints_count %> owned · <%= @wishlist_count %> wanted · <%= pluralize(@projects_count, "project") %>
      </p>
    </div>
    <div class="flex flex-wrap gap-2.5">
      <%= link_to "Import paints", bulk_import_user_paints_path, class: "btn btn-outline" %>
      <%= link_to new_user_paint_path, class: "btn btn-primary", data: {turbo_frame: "modal"} do %>
        <%= ph_icon(:plus, size: 18, stroke: 2.6) %>Add paint
      <% end %>
    </div>
  </div>

  <div class="grid gap-5 grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))]">
    <section class="panel-inverse p-7 flex flex-col gap-4" aria-labelledby="rack-check-title">
      <h2 id="rack-check-title" class="cond font-black text-4xl leading-[.95]">At the shop?<br>Do I own it?</h2>
      <%= form_with url: user_root_path, method: :get,
            data: {turbo_frame: "rack-check", controller: "auto-submit"} do %>
        <label class="flex items-center gap-2.5 h-14 px-4 rounded bg-page text-base-content">
          <%= ph_icon(:search, size: 20) %>
          <span class="sr-only">Check a paint against your rack</span>
          <%= search_field_tag :check, @check_query, placeholder: "Paint name, e.g. Abaddon Black",
                autocomplete: "off",
                class: "w-full bg-transparent border-0 outline-none text-lg font-medium",
                data: {action: "input->auto-submit#debouncedSubmit"} %>
        </label>
      <% end %>
      <%= render "dashboard/rack_check" %>
    </section>

    <section class="panel p-6 flex flex-col gap-3.5" aria-labelledby="shopping-list-title">
      <div class="flex justify-between items-baseline gap-3">
        <h2 id="shopping-list-title" class="cond font-black text-[28px]">Shopping list</h2>
        <% if @wishlist_count.positive? %>
          <%= link_to "All #{@wishlist_count} wanted →", user_paints_path(status: :wishlist), class: "text-link text-sm" %>
        <% end %>
      </div>
      <% if @wishlist_items.any? %>
        <ul class="flex flex-col">
          <% @wishlist_items.each do |user_paint| %>
            <li id="<%= dom_id(user_paint) %>" class="flex items-center gap-3 py-2 border-b border-line">
              <span class="w-8 h-8 rounded-[3px] shrink-0" style="<%= paint_swatch_style(user_paint.paint) %>"></span>
              <%= link_to user_paint_path(user_paint), class: "flex-1 min-w-0 flex flex-col no-underline hover:text-accent-text" do %>
                <b class="text-[15px] font-semibold"><%= user_paint.paint.name %></b>
                <span class="text-xs text-muted"><%= user_paint.paint.product_line.brand.name %> · <%= user_paint.paint.product_line.name %></span>
              <% end %>
              <%= button_to "Got it", user_paint_path(user_paint), method: :patch,
                    params: {user_paint: {status: "owned"}},
                    class: "h-9 px-3 rounded border-2 border-line-strong text-[13px] font-semibold hover:border-base-content cursor-pointer",
                    form: {class: "shrink-0"},
                    aria: {label: "Got it: mark #{user_paint.paint.name} as owned"} %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="panel-dashed p-5 flex flex-col gap-1.5 items-start">
          <span class="cond font-extrabold text-[22px]">Nothing on the wishlist</span>
          <span class="text-sm text-soft">Mark paints as Wanted from the catalogue and they'll show up here as a shopping list.</span>
          <%= link_to "Browse catalogue →", paints_path, class: "cond mt-1.5 font-extrabold text-base text-accent-text no-underline" %>
        </div>
      <% end %>
    </section>
  </div>

  <section class="flex flex-col gap-3.5" aria-labelledby="recent-title">
    <div class="flex justify-between items-baseline gap-3">
      <h2 id="recent-title" class="cond font-black text-[28px]">Recently added</h2>
      <% if @recent_additions.any? %>
        <%= link_to "Open rack →", user_paints_path, class: "text-link text-sm" %>
      <% end %>
    </div>
    <% if @recent_additions.any? %>
      <div class="grid grid-cols-3 md:grid-cols-6 gap-2.5">
        <% @recent_additions.each do |user_paint| %>
          <%= link_to user_paint_path(user_paint), class: "flex flex-col gap-2 min-w-0 no-underline group" do %>
            <span class="h-24 rounded border border-line" style="<%= paint_swatch_style(user_paint.paint) %>"></span>
            <span class="flex flex-col">
              <b class="text-sm font-semibold leading-tight group-hover:text-accent-text"><%= user_paint.paint.name %></b>
              <span class="text-xs text-muted"><%= user_paint.paint.product_line.brand.name %> · <%= time_ago_in_words(user_paint.created_at) %> ago</span>
            </span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="panel-dashed p-8 md:p-12 flex flex-col items-start gap-3">
        <span class="cond font-black text-4xl leading-[.95]">Your rack is empty</span>
        <span class="text-base text-soft max-w-[520px]">Import a typed list or a photo of your shelf, or find paints in the catalogue and mark them Owned.</span>
        <div class="flex flex-wrap gap-2.5 mt-2">
          <%= link_to "Import paints", bulk_import_user_paints_path, class: "btn btn-primary" %>
          <%= link_to "Browse catalogue", paints_path, class: "btn btn-outline" %>
        </div>
      </div>
    <% end %>
  </section>

  <% if @latest_project || @latest_video %>
    <div class="grid gap-5 grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))]">
      <% if @latest_project %>
        <section class="panel p-6 flex gap-4.5 items-center">
          <% if @latest_project_photo %>
            <%= image_tag optimized_variant(@latest_project_photo, :thumb), alt: "",
                  class: "w-30 h-30 shrink-0 rounded object-cover border-2 border-line" %>
          <% else %>
            <div class="w-30 h-30 shrink-0 rounded bg-base-200 border-2 border-dashed border-line-strong flex items-center justify-center text-[11px] text-muted text-center">No photo yet</div>
          <% end %>
          <div class="flex flex-col gap-1.5 min-w-0">
            <span class="eyebrow text-[11px]">Your project · updated <%= time_ago_in_words(@latest_project.updated_at) %> ago</span>
            <%= link_to @latest_project.title, project_path(@latest_project), class: "cond font-black text-[26px] leading-none no-underline hover:text-accent-text" %>
            <span class="text-sm text-soft">
              <%= pluralize(@latest_project_stats[:updates], "update") %> · <%= pluralize(@latest_project_stats[:photos], "photo") %> · <%= pluralize(@latest_project_stats[:paints], "paint") %> used
            </span>
            <%= link_to "Post an update →", new_project_project_update_path(@latest_project), class: "text-link text-sm" %>
          </div>
        </section>
      <% end %>

      <% if @latest_video %>
        <section class="panel p-6 flex flex-col gap-2.5">
          <span class="eyebrow text-[11px]">Video paint list</span>
          <%= link_to (@latest_video.title.presence || "Untitled video"), video_path(@latest_video),
                class: "cond font-black text-[26px] leading-none no-underline hover:text-accent-text" %>
          <% if @latest_video_total.positive? %>
            <div class="flex items-center gap-3">
              <span class="flex-1 h-2 rounded-full bg-base-200 overflow-hidden flex" aria-hidden="true">
                <span class="bg-primary" style="width: <%= (@latest_video_owned * 100.0 / @latest_video_total).round %>%"></span>
              </span>
              <span class="text-sm font-semibold"><%= @latest_video_owned %> of <%= @latest_video_total %> on your rack</span>
            </div>
            <% missing = @latest_video_total - @latest_video_owned %>
            <%= link_to (missing.positive? ? "See the #{missing} you're missing →" : "Open the paint list →"),
                  video_path(@latest_video), class: "text-link text-sm" %>
          <% else %>
            <%= link_to "Open the paint list →", video_path(@latest_video), class: "text-link text-sm" %>
          <% end %>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
