<% content_for :title, "#{@brand.name} Paints | PaintHoarder" %>
<% content_for :description, "Browse all #{@brand.name} paint product lines and colors. Find the perfect paint for your miniatures." %>
<%= render_og_tags(brand_show_og_tags(@brand)) %>
<%= render_structured_data(brand_structured_data(@brand, @product_lines)) %>

<%= render "shared/breadcrumbs", crumbs: [
  { label: "Home", path: root_path },
  { label: "Brands", path: brands_path },
  { label: @brand.name }
] %>

<!-- Brand Header -->
<div class="flex items-center gap-5 mb-8">
  <% if @brand.logo.attached? %>
    <div class="w-20 h-20 rounded-2xl overflow-hidden bg-base-200 flex-shrink-0 border border-base-300/30 shadow-md">
      <%= image_tag @brand.logo, class: "w-full h-full object-contain p-2", alt: @brand.name %>
    </div>
  <% else %>
    <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center flex-shrink-0 border border-base-300/30 shadow-md">
      <span class="text-2xl font-bold text-primary/60"><%= @brand.name.first(2).upcase %></span>
    </div>
  <% end %>
  <div>
    <h1 class="text-3xl sm:text-4xl font-bold text-base-content"><%= @brand.name %></h1>
    <% if @brand.url.present? %>
      <a href="<%= @brand.url %>" target="_blank" rel="noopener noreferrer" class="text-sm text-primary hover:underline mt-1 inline-flex items-center gap-1">
        <%= @brand.url.gsub(%r{https?://}, '') %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    <% end %>
  </div>
</div>

<!-- Product Lines -->
<h2 class="text-xl font-semibold mb-4">Product Lines</h2>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @product_lines.each do |product_line| %>
    <%= link_to brand_product_line_path(@brand, product_line), class: "card bg-base-100 shadow-md hover:shadow-xl border border-base-300/50 transition-all duration-300 group" do %>
      <div class="card-body p-5">
        <h3 class="text-lg font-bold text-base-content group-hover:text-primary transition-colors">
          <%= product_line.name %>
        </h3>
        <% if product_line.description.present? %>
          <p class="text-sm text-base-content/60 line-clamp-2 mt-1"><%= product_line.description %></p>
        <% end %>
        <div class="flex items-center justify-between mt-3">
          <span class="text-sm text-base-content/60"><%= product_line.paints_count %> paints</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/30 group-hover:text-primary/60 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
