  <div class="bg-gradient-to-br from-primary/5 via-transparent to-secondary/5">


      <!-- Article Header -->
      <div class="max-w-3xl">
        <h1 class="text-4xl lg:text-5xl font-bold text-base-content leading-tight mb-6">
          <%= @page.title %>
        </h1>

        <!-- Article Meta -->
        <div class="flex items-center gap-4 mb-8">
          <div class="flex items-center gap-3">
            <!-- Author Avatar -->
            <div class="w-12 h-12 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.02.02l-.01 13.93A2.01 2.01 0 0114 20H4a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v.02z" />
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-semibold text-base-content">PaintHoarder Team</span>
                <div class="badge badge-primary badge-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  Official
                </div>
              </div>
              <div class="flex items-center gap-2 text-sm text-base-content/60">
                <span><%= @page.created_at.strftime("%B %d, %Y") %></span>
                <span>•</span>
                <span><%= reading_time(@page.content.to_s) %> min read</span>
                <span>•</span>
                <div class="flex items-center gap-1">
                  <% case @page.status %>
                  <% when 'draft' %>
                    <div class="badge badge-ghost badge-sm">Draft</div>
                  <% when 'issued' %>
                    <div class="badge badge-success badge-sm">Published</div>
                  <% when 'archived' %>
                    <div class="badge badge-neutral badge-sm">Archived</div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <% if current_user&.admin? %>
          <div class="flex items-center gap-3">
            <%= link_to edit_page_path(@page), class: "btn btn-primary btn-sm gap-2" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              Edit Post
            <% end %>
            <%= button_to page_path(@page), method: :delete,
                data: { turbo_confirm: "Are you sure you want to delete this post?" },
                class: "btn btn-error btn-sm gap-2" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              Delete
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

<!-- Article Content -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    <!-- Main Content -->
    <article class="lg:col-span-3">
      <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 overflow-hidden">
        <div class="p-8 lg:p-12">
          <!-- Rich Text Content -->
          <div class="prose prose-lg max-w-none prose-headings:text-base-content prose-p:text-base-content/80 prose-strong:text-base-content prose-a:text-primary hover:prose-a:text-primary-focus prose-code:text-primary prose-code:bg-primary/10 prose-pre:bg-base-200 prose-blockquote:border-primary prose-blockquote:text-base-content/70">
            <%= @page.content %>
          </div>
        </div>


      </div>
    </article>

    <!-- Sidebar -->
    <aside class="lg:col-span-1">
      <div class="sticky top-24 space-y-6">
        <% if current_user&.admin? %>
        <!-- Quick Actions -->
        <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 p-6">
          <h3 class="font-semibold text-base-content mb-4">Quick Actions</h3>
          <div class="space-y-3">
            <%= link_to pages_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-base-200 transition-colors group" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
              </svg>
              <span class="text-sm font-medium">All Posts</span>
            <% end %>
              <%= link_to new_page_path, class: "flex items-center gap-3 p-3 rounded-xl hover:bg-base-200 transition-colors group" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span class="text-sm font-medium">Create New</span>
              <% end %>
          </div>
        </div>
        <% end %>

        <!-- Article Info -->
        <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 p-6">
          <h3 class="font-semibold text-base-content mb-4">Article Info</h3>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-base-content/60">Published</span>
              <span class="text-base-content"><%= @page.created_at.strftime("%b %d, %Y") %></span>
            </div>
            <% if @page.updated_at != @page.created_at %>
              <div class="flex justify-between">
                <span class="text-base-content/60">Updated</span>
                <span class="text-base-content"><%= @page.updated_at.strftime("%b %d, %Y") %></span>
              </div>
            <% end %>
            <div class="flex justify-between">
              <span class="text-base-content/60">Status</span>
              <% case @page.status %>
              <% when 'draft' %>
                <div class="badge badge-ghost badge-sm">Draft</div>
              <% when 'issued' %>
                <div class="badge badge-success badge-sm">Published</div>
              <% when 'archived' %>
                <div class="badge badge-neutral badge-sm">Archived</div>
              <% end %>
            </div>
            <div class="flex justify-between">
              <span class="text-base-content/60">Reading Time</span>
              <span class="text-base-content"><%= reading_time(@page.content.to_s) %> min</span>
            </div>
          </div>
        </div>

        <!-- Community Engagement (Placeholder) -->

      </div>
    </aside>
  </div>
