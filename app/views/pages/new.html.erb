<% content_for :hero do %>
  <div class="bg-gradient-to-br from-primary/10 via-secondary/5 to-accent/10 border-b border-base-300">
    <div class="max-w-4xl mx-auto px-4 py-8">
      <!-- Back Navigation -->
      <div class="mb-6">
        <%= link_to pages_path, class: "inline-flex items-center gap-2 text-base-content/60 hover:text-base-content transition-colors group" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Community Hub
        <% end %>
      </div>

      <!-- Page Header -->
      <div class="max-w-2xl">
        <h1 class="text-3xl lg:text-4xl font-bold text-base-content leading-tight mb-4">
          Create New Post
        </h1>
        <p class="text-lg text-base-content/70">
          Share your knowledge, techniques, and insights with the miniature painting community. Whether it's a tutorial, review, or community update, your content helps others grow.
        </p>
      </div>
    </div>
  </div>
<% end %>

<div class="max-w-4xl mx-auto">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Form -->
    <div class="lg:col-span-2">
      <%= render "form", page: @page %>
    </div>

    <!-- Sidebar -->
    <div class="lg:col-span-1">
      <div class="sticky top-24 space-y-6">
        <!-- Post Guidelines -->
        <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 p-6">
          <h3 class="font-semibold text-base-content mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Community Guidelines
          </h3>
          <div class="space-y-3 text-sm text-base-content/70">
            <div class="flex items-start gap-2">
              <div class="w-1.5 h-1.5 bg-success rounded-full mt-2 flex-shrink-0"></div>
              <span>Keep content relevant to miniature painting</span>
            </div>
            <div class="flex items-start gap-2">
              <div class="w-1.5 h-1.5 bg-success rounded-full mt-2 flex-shrink-0"></div>
              <span>Be respectful and constructive in your approach</span>
            </div>
            <div class="flex items-start gap-2">
              <div class="w-1.5 h-1.5 bg-success rounded-full mt-2 flex-shrink-0"></div>
              <span>Credit sources and inspirations appropriately</span>
            </div>
            <div class="flex items-start gap-2">
              <div class="w-1.5 h-1.5 bg-success rounded-full mt-2 flex-shrink-0"></div>
              <span>Use high-quality images when possible</span>
            </div>
          </div>
        </div>

        <!-- Content Ideas -->
        <div class="bg-gradient-to-br from-secondary/5 to-accent/5 rounded-2xl border border-secondary/20 p-6">
          <h3 class="font-semibold text-base-content mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
            Content Ideas
          </h3>
          <div class="space-y-3">
            <div class="p-3 bg-base-100 rounded-xl">
              <h4 class="font-medium text-base-content text-sm mb-1">Tutorials</h4>
              <p class="text-xs text-base-content/60">Step-by-step painting guides, technique explanations</p>
            </div>
            <div class="p-3 bg-base-100 rounded-xl">
              <h4 class="font-medium text-base-content text-sm mb-1">Reviews</h4>
              <p class="text-xs text-base-content/60">Paint, brush, or tool reviews and comparisons</p>
            </div>
            <div class="p-3 bg-base-100 rounded-xl">
              <h4 class="font-medium text-base-content text-sm mb-1">Showcases</h4>
              <p class="text-xs text-base-content/60">Share your completed miniatures and techniques used</p>
            </div>
            <div class="p-3 bg-base-100 rounded-xl">
              <h4 class="font-medium text-base-content text-sm mb-1">Community</h4>
              <p class="text-xs text-base-content/60">Events, challenges, or community announcements</p>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-base-100 rounded-2xl shadow-sm border border-base-300 p-6">
          <h3 class="font-semibold text-base-content mb-4">Need Help?</h3>
          <div class="space-y-3">
            <a href="#" class="flex items-center gap-3 p-3 rounded-xl hover:bg-base-200 transition-colors group">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-medium">Writing Guide</span>
            </a>
            <a href="#" class="flex items-center gap-3 p-3 rounded-xl hover:bg-base-200 transition-colors group">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="text-sm font-medium">Image Guidelines</span>
            </a>
            <a href="#" class="flex items-center gap-3 p-3 rounded-xl hover:bg-base-200 transition-colors group">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/60 group-hover:text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
              </svg>
              <span class="text-sm font-medium">Get Support</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
