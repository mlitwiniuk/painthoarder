<%# app/views/pages/welcome.html.erb %>
<% content_for :title, "PaintHoarder - The Social Hub for Miniature Painters" %>
<% content_for :bare, true %>
<%
  # "12,500+" style: round big numbers down so the claim stays true.
  rounded_count = ->(n) { n >= 1000 ? "#{number_with_delimiter((n / 100) * 100)}+" : number_with_delimiter(n) }

  rack = [
    ["#9A1115", "MEPHISTON RED", 220], ["#1F3A5A", "DK PRUSSIAN BLUE", 180], ["#A07D3B", "RETRIBUTOR", 240],
    ["#DBD1B2", "WRAITHBONE", 200], ["#8A5A2B", "SNAKEBITE", 160], ["#F2F1EC", "TITANIUM WHT", 230],
    ["#5E6466", "LEADBELCHER", 190], ["#1C1A1A", "NULN OIL", 150], ["#D2A285", "KISLEV FLESH", 210],
    ["#3E6B3A", "WARBOSS GRN", 175], ["#8E4A26", "RUST", 225], ["#4B2E5C", "NAGGAROTH NT", 195],
    ["#D9762B", "GRYPH-HOUND", 170], ["#2C6E7A", "AHRIMAN BLUE", 205]
  ]
%>

<section class="wrap pt-14 pb-10 flex flex-col gap-7">
  <span class="font-mono text-[13px] text-muted tracking-[.06em]">
    // <%= rounded_count.call(@paint_count) %> PAINTS · <%= @brand_count %> BRANDS · FREE FOR HOBBY PAINTERS
  </span>
  <h1 class="display-title">Your rack.<br><span class="text-accent-text">Catalogued.</span></h1>
  <div class="flex flex-wrap gap-8 items-end justify-between">
    <p class="text-[19px] leading-normal text-soft max-w-[520px]">
      Know what you own before you buy it again, swap brands without guessing, and pull the paint list out of any tutorial.
    </p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Start your rack", new_user_registration_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Browse paints", paints_path, class: "btn btn-outline btn-lg" %>
    </div>
  </div>
</section>

<section class="wrap pb-20" aria-label="Example paint rack">
  <div class="grid grid-cols-7 md:grid-cols-14 gap-2 items-end" aria-hidden="true">
    <% rack.each do |hex, code, height| %>
      <div class="flex flex-col gap-2 min-w-0">
        <div class="rounded-t-[3px] border border-line h-[calc(var(--h)*0.6)] md:h-(--h)" style="--h: <%= height %>px; background: <%= hex %>"></div>
        <span class="font-mono text-[10px] text-muted truncate"><%= code %></span>
      </div>
    <% end %>
  </div>
</section>

<section class="wrap pb-22 flex flex-col gap-8">
  <h2 class="cond font-black text-[clamp(2.5rem,6vw,3.5rem)] leading-[.9]">Three things it's<br>really good at</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-5">
    <article class="panel p-7 flex flex-col gap-5">
      <div class="bg-page border-2 border-line rounded p-3.5 flex flex-col gap-2.5" aria-hidden="true">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-[3px] shrink-0" style="background: #1C1A1A"></span>
          <span class="flex-1 text-sm font-semibold">Abaddon Black</span>
          <%= status_tag("owned", size: :sm, count: 2) %>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-[3px] shrink-0" style="background: #D9762B"></span>
          <span class="flex-1 text-sm font-semibold">Gryph-Hound Orange</span>
          <%= status_tag("wishlist", size: :sm) %>
        </div>
      </div>
      <span class="cond font-black text-[44px] leading-none text-accent-text">01</span>
      <h3 class="cond font-extrabold text-[30px] leading-none">Your rack, in your pocket</h3>
      <p class="text-base leading-relaxed text-soft">Owned, wanted, avoid. Import a typed list or a photo of your shelf, then check it at the shop.</p>
    </article>

    <article class="panel p-7 flex flex-col gap-5">
      <div class="bg-page border-2 border-line rounded p-3.5 flex flex-col gap-2.5" aria-hidden="true">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-[3px] shrink-0" style="background: #9A1115"></span>
          <span class="flex-1 text-sm font-semibold">Mephiston Red <span class="text-muted font-normal">→</span></span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-[3px] shrink-0" style="background: #A01B20"></span>
          <span class="flex-1 text-sm font-semibold">Bloody Red</span>
          <%= match_meter(3, small: true) %>
          <span class="text-xs text-muted">Very close</span>
        </div>
      </div>
      <span class="cond font-black text-[44px] leading-none text-accent-text">02</span>
      <h3 class="cond font-extrabold text-[30px] leading-none">Brand swaps, rated</h3>
      <p class="text-base leading-relaxed text-soft">Closest equivalents across every brand, with the ones already on your rack listed first.</p>
    </article>

    <article class="panel p-7 flex flex-col gap-5">
      <div class="bg-page border-2 border-line rounded p-3.5 flex flex-col gap-2.5" aria-hidden="true">
        <div class="flex items-center gap-2.5">
          <span class="font-mono text-[11px] text-accent-text w-10">03:12</span>
          <span class="w-5 h-5 rounded-[3px] shrink-0" style="background: #5E6466"></span>
          <span class="flex-1 text-sm font-semibold">Leadbelcher</span>
          <span class="text-xs text-muted">You own it</span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="font-mono text-[11px] text-accent-text w-10">07:45</span>
          <span class="w-5 h-5 rounded-[3px] shrink-0" style="background: #1C1A1A"></span>
          <span class="flex-1 text-sm font-semibold">Nuln Oil</span>
          <span class="text-xs text-muted">You own it</span>
        </div>
      </div>
      <span class="cond font-black text-[44px] leading-none text-accent-text">03</span>
      <h3 class="cond font-extrabold text-[30px] leading-none">Tutorial → paint list</h3>
      <p class="text-base leading-relaxed text-soft">Paste a YouTube link. Get every paint mentioned, with timestamps, checked against your rack.</p>
    </article>
  </div>
</section>

<section class="border-t-2 border-line">
  <div class="wrap py-18 flex flex-wrap justify-between items-center gap-6">
    <h2 class="cond font-black text-[clamp(2.5rem,6vw,4rem)] leading-[.9]">The pile of shame<br>has a database now.</h2>
    <%= link_to "Create free account", new_user_registration_path, class: "btn btn-primary btn-lg" %>
  </div>
</section>
