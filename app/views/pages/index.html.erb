<% content_for :hero do %>
  <div class="bg-gradient-to-br from-primary/10 via-secondary/5 to-accent/10 border-b border-base-300">
    <div class="max-w-7xl mx-auto px-4 py-12">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl font-bold text-base-content mb-4">
          Community Hub
        </h1>
        <p class="text-lg text-base-content/70 mb-8">
          Discover inspiring content, tutorials, and community updates from fellow miniature painters
        </p>
        <% if current_user&.admin? %>
          <div class="flex justify-center gap-4">
            <%= link_to new_page_path, class: "btn btn-primary gap-2 shadow-lg" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Create New Post
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="max-w-4xl mx-auto">
  <!-- Content Feed -->
  <div class="space-y-6">
    <% if @pages.any? %>
      <% @pages.each do |page| %>
        <article class="group bg-base-100 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-base-300 hover:border-base-content/20 overflow-hidden">
          <!-- Post Header -->
          <div class="p-6 pb-0">
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center gap-3">
                <!-- Author Avatar (admin indicator) -->
                <div class="w-12 h-12 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.02.02l-.01 13.93A2.01 2.01 0 0114 20H4a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v.02z" />
                  </svg>
                </div>

                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="font-semibold text-base-content">PaintHoarder Team</h3>
                    <div class="badge badge-primary badge-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Official
                    </div>
                  </div>
                  <div class="flex items-center gap-2 text-sm text-base-content/60">
                    <span><%= page.created_at.strftime("%B %d, %Y") %></span>
                    <span>•</span>
                    <div class="flex items-center gap-1">
                      <% case page.status %>
                      <% when 'draft' %>
                        <div class="badge badge-ghost badge-sm">Draft</div>
                      <% when 'issued' %>
                        <div class="badge badge-success badge-sm">Published</div>
                      <% when 'archived' %>
                        <div class="badge badge-neutral badge-sm">Archived</div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Action Menu -->
              <% if current_user&.admin? %>
                <div class="dropdown dropdown-end opacity-0 group-hover:opacity-100 transition-opacity">
                  <label tabindex="0" class="btn btn-ghost btn-sm btn-circle hover:bg-base-200">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                    </svg>
                  </label>
                  <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-xl bg-base-100 rounded-xl w-44 border border-base-300">
                    <li>
                      <%= link_to edit_page_path(page), class: "text-base-content/70 hover:bg-base-200" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                        Edit Post
                      <% end %>
                    </li>
                    <li>
                      <%= button_to page_path(page), method: :delete,
                          data: { turbo_confirm: "Are you sure you want to delete this post?" },
                          class: "flex items-center w-full text-error hover:bg-error/10" do %>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Delete
                      <% end %>
                    </li>
                  </ul>
                </div>
              <% end %>
            </div>

            <!-- Post Title -->
            <%= link_to page_path(page), class: "block group/title mb-4" do %>
              <h2 class="text-2xl font-bold text-base-content group-hover/title:text-primary transition-colors leading-tight">
                <%= page.title %>
              </h2>
            <% end %>
          </div>

          <!-- Post Content Preview -->
          <div class="px-6">
            <div class="prose prose-base max-w-none text-base-content/80 line-clamp-3">
              <%= truncate(strip_tags(page.content.to_s), length: 300, separator: ' ') %>
            </div>
          </div>

          <!-- Post Actions -->
          <div class="p-6 pt-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-4">
                <!-- Read More Button -->
                <%= link_to page_path(page), class: "text-primary hover:text-primary-focus font-medium text-sm flex items-center gap-2 group/read" do %>
                  Read More
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover/read:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                <% end %>
              </div>

              <!-- Engagement Indicators (placeholder for future social features) -->
              <div class="flex items-center gap-4 text-base-content/40">
                <div class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                  <span class="text-sm"><%= rand(50..500) %></span>
                </div>
                <div class="flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                  <span class="text-sm"><%= rand(5..50) %></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Hover Effect Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-transparent via-transparent to-primary/2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
        </article>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16">
        <div class="w-24 h-24 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-base-content mb-2">No posts yet</h3>
        <p class="text-base-content/60 mb-6 max-w-md mx-auto">
          The community hub is just getting started. Check back soon for inspiring content and tutorials!
        </p>
        <% if current_user&.admin? %>
          <%= link_to new_page_path, class: "btn btn-primary gap-2" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Create First Post
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
