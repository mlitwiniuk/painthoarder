<% content_for :title, "#{@product_line.name} by #{@brand.name} | PaintHoarder" %>
<% content_for :description, "Browse all #{@product_line.name} paints by #{@brand.name}. #{@product_line.description.presence || 'Find colors for your miniature painting projects.'}" %>
<%= render_og_tags(product_line_og_tags(@brand, @product_line)) %>
<%= render_structured_data(product_line_structured_data(@brand, @product_line, @paints)) %>

<%= render "shared/breadcrumbs", crumbs: [
  { label: "Home", path: root_path },
  { label: "Brands", path: brands_path },
  { label: @brand.name, path: brand_path(@brand) },
  { label: @product_line.name }
] %>

<!-- Header -->
<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-base-content/60 mb-2">
    <%= link_to @brand.name, brand_path(@brand), class: "hover:text-primary transition-colors" %>
  </div>
  <h1 class="text-3xl sm:text-4xl font-bold text-base-content mb-2"><%= @product_line.name %></h1>
  <% if @product_line.description.present? %>
    <p class="text-base-content/60 text-lg"><%= @product_line.description %></p>
  <% end %>
</div>

<!-- Color Filter -->
<% if @color_categories.present? %>
  <div class="mb-6">
    <div class="flex flex-wrap gap-2">
      <%= link_to "All", brand_product_line_path(@brand, @product_line),
          class: "btn btn-sm #{params[:color].blank? ? 'btn-primary' : 'btn-ghost'}" %>
      <% @color_categories.each do |category| %>
        <%= link_to category,
            brand_product_line_path(@brand, @product_line, color: category.downcase),
            class: "btn btn-sm #{params[:color]&.downcase == category.downcase ? 'btn-primary' : 'btn-ghost'}" %>
      <% end %>
    </div>
  </div>
<% end %>

<!-- Paint Count -->
<div class="text-sm text-base-content/60 mb-4">
  <%= @pagy.count %> paints
</div>

<!-- Paint Grid -->
<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
  <% @paints.each do |paint| %>
    <% user_paint = if user_signed_in?
         current_user.user_paints.find_by(paint_id: paint.id) || UserPaint.new(paint: paint, user: current_user, virtual: true)
       else
         UserPaint.new(paint: paint, virtual: true)
       end %>
    <%= render "paints/modern_catalog_card", user_paint: user_paint %>
  <% end %>
</div>

<!-- Pagination -->
<% if @pagy.pages > 1 %>
  <div class="mt-8 flex justify-center">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>
