<% content_for :title, "My Collection" %>

<!-- Modern Collection Header -->
<div class="mb-8">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
    <div>
      <h1 class="text-4xl font-bold text-base-content mb-2">
        My Paint Collection
        <span class="text-2xl text-base-content/40 font-normal">🎨</span>
      </h1>
      <p class="text-base-content/60 text-lg">Discover, organize, and showcase your miniature paints</p>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center gap-3">
      <%= link_to bulk_import_user_paints_path, class: "btn btn-ghost btn-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
        </svg>
        Bulk Import
      <% end %>
      <%= link_to new_user_paint_path, class: "btn btn-primary shadow-lg hover:shadow-xl transition-all", data: { turbo_frame: "modal" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add Paint
      <% end %>
    </div>
  </div>
</div>

<!-- Stats Grid -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="stats shadow-lg bg-base-100 border border-base-300">
    <div class="stat place-items-center">
      <div class="stat-title text-base-content/60">Owned</div>
      <div class="stat-value text-primary text-2xl"><%= @owned_count %></div>
    </div>
  </div>
  <div class="stats shadow-lg bg-base-100 border border-base-300">
    <div class="stat place-items-center">
      <div class="stat-title text-base-content/60">Wishlist</div>
      <div class="stat-value text-secondary text-2xl"><%= @wishlist_count %></div>
    </div>
  </div>
  <div class="stats shadow-lg bg-base-100 border border-base-300">
    <div class="stat place-items-center">
      <div class="stat-title text-base-content/60">Brands</div>
      <div class="stat-value text-accent text-2xl"><%= current_user.paints.distinct.joins(product_line: :brand).select('brands.id').distinct.count %></div>
    </div>
  </div>
  <div class="stats shadow-lg bg-base-100 border border-base-300">
    <div class="stat place-items-center">
      <div class="stat-title text-base-content/60">Total</div>
      <div class="stat-value text-info text-2xl"><%= @all_count %></div>
    </div>
  </div>
</div>

<!-- Modern Filter Navigation -->
<div class="sticky top-0 z-40 bg-base-100/90 backdrop-blur-xl border-b border-base-300 -mx-4 px-4 mb-8" data-controller="toggle">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 py-4">
    <!-- Status Filter Tabs -->
    <div class="flex items-center gap-1 bg-base-200 rounded-full p-1 overflow-x-auto">
      <%= link_to user_paints_path(color: params[:color], status: nil),
              class: "px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap #{params[:status] == 'all' || params[:status].blank? ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-300'}" do %>
        All <span class="ml-1 opacity-60">(<%= @all_count %>)</span>
      <% end %>
      <%= link_to user_paints_path(color: params[:color], status: :owned),
              class: "px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap #{params[:status] == 'owned' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-300'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        Owned <span class="ml-1 opacity-60">(<%= @owned_count %>)</span>
      <% end %>
      <%= link_to user_paints_path(color: params[:color], status: :wishlist),
              class: "px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap #{params[:status] == 'wishlist' ? 'bg-secondary text-secondary-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-300'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
        Wishlist <span class="ml-1 opacity-60">(<%= @wishlist_count %>)</span>
      <% end %>
      <%= link_to user_paints_path(color: params[:color], status: :avoid),
              class: "px-4 py-2 rounded-full text-sm font-medium transition-all whitespace-nowrap #{params[:status] == 'avoid' ? 'bg-error text-error-content shadow-sm' : 'text-base-content/70 hover:text-base-content hover:bg-base-300'}" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
        </svg>
        Avoid <span class="ml-1 opacity-60">(<%= @avoid_count %>)</span>
      <% end %>
    </div>

    <!-- Filter & More Actions -->
    <div class="flex items-center gap-3">
      <button class="btn btn-ghost btn-sm hover:bg-base-200" data-action="click->toggle#toggle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        Filters
      </button>

      <%= link_to color_wheel_user_paints_path, class: "btn btn-ghost btn-sm hover:bg-base-200" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
        </svg>
        Color Wheel
      <% end %>
    </div>
  </div>

  <!-- Collapsible Filter Section -->
  <%= turbo_frame_tag "collection-filters" do %>
    <div data-toggle-target="content" class="hidden pb-4">
      <div class="bg-base-200 rounded-2xl p-6 border border-base-300">
        <%= render "shared/filter_form",
            q: @q,
            url: user_paints_path,
            turbo_frame: "collection-results",
            brands: @brands,
            product_lines: @product_lines,
            color_categories: @color_categories,
            clear_url: user_paints_path(status: params[:status]),
            brand_field: :paint_product_line_brand_id_eq,
            product_line_field: :paint_product_line_id_eq %>
      </div>
    </div>
  <% end %>
</div>

<!-- Modern Paint Collection Grid -->
<%= turbo_frame_tag "collection-results" do %>
  <% if @user_paints.any? %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6 gap-4 lg:gap-6">
      <% @user_paints.each do |user_paint| %>
        <%= render 'user_paints/modern_paint_card', user_paint: user_paint %>
      <% end %>
    </div>
  <% else %>
    <!-- Modern Empty State -->
    <div class="flex flex-col items-center justify-center py-20">
      <div class="w-32 h-32 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-3xl flex items-center justify-center mb-8 shadow-lg">
        <% case params[:status] %>
        <% when 'wishlist' %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        <% when 'avoid' %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        <% else %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        <% end %>
      </div>

      <h2 class="text-3xl font-bold text-base-content mb-4">
        <% if params[:q].present? || params[:color].present? %>
          No matches found 🔍
        <% else %>
          <%= case params[:status]
              when 'owned', nil
                "Start your collection ✨"
              when 'wishlist'
                "Build your wishlist 💫"
              when 'avoid'
                "No paints to avoid"
              else
                "No paints found"
              end %>
        <% end %>
      </h2>

      <p class="text-base-content/60 text-center max-w-md mb-8 leading-relaxed text-lg">
        <% if params[:q].present? || params[:color].present? %>
          Try adjusting your filters or search terms to find what you're looking for.
        <% else %>
          <%= case params[:status]
              when 'owned', nil
                "Add your first paint to start building your collection. Track what you own, discover new colors, and organize your hobby like a pro."
              when 'wishlist'
                "Found a paint you want? Add it to your wishlist so you never forget what to buy next time you're at the store."
              when 'avoid'
                "Keep track of paints you want to avoid for any reason - maybe they don't work well with your style or you've had bad experiences."
              else
                "Start exploring and building your amazing paint collection."
              end %>
        <% end %>
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <% if params[:q].present? || params[:color].present? %>
          <%= link_to "Clear Filters", user_paints_path(status: params[:status]),
              class: "btn btn-outline" %>
        <% end %>
        <%= link_to new_user_paint_path,
            class: "btn btn-primary shadow-lg hover:shadow-xl transition-all",
            data: { turbo_frame: "modal" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Add Your First Paint
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
</div>

<%= turbo_frame_tag "modal" %>
