<% content_for :title, "My rack" %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap items-end justify-between gap-5">
    <div class="flex flex-col gap-1.5">
      <h1 class="page-title">My rack</h1>
      <p class="eyebrow md:hidden">
        <%= @owned_count %> owned · <%= @wishlist_count %> wanted
      </p>
    </div>

    <div class="flex flex-wrap gap-2.5">
      <%= link_to color_wheel_user_paints_path, class: "btn btn-outline hidden sm:inline-flex" do %>
        <%= ph_icon(:wheel, size: 18, stroke: 2.4) %>Colour wheel
      <% end %>
      <%= link_to "Import", bulk_import_user_paints_path, class: "btn btn-outline hidden sm:inline-flex" %>
      <%= link_to new_user_paint_path, class: "btn btn-primary", data: { turbo_frame: "modal" } do %>
        <%= ph_icon(:plus, size: 18, stroke: 2.6) %>Add paint
      <% end %>
    </div>
  </div>

  <%= render "user_paints/rack_filters" %>

  <%= turbo_frame_tag "collection-results", class: "flex flex-col gap-6" do %>
    <%= render "user_paints/status_tabs", counts: @status_counts %>
    <%= render "user_paints/rack_grid", user_paints: @user_paints %>
  <% end %>
</div>
