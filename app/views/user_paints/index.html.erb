<% content_for :title, "My Paint Collection | PaintHoarder" %>

<div class="max-w-7xl mx-auto">
  <!-- Hero Section with Stats -->
  <div class="relative bg-gradient-to-br from-primary/10 to-secondary/10 rounded-3xl p-8 mb-8 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-primary/5 to-transparent"></div>
    <div class="relative z-10">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div>
          <h1 class="text-4xl lg:text-5xl font-bold bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent mb-2">
            My Paint Collection
          </h1>
          <p class="text-base-content/60 text-lg">Discover, organize, and showcase your miniature paints</p>
        </div>

        <!-- Quick Stats -->
        <div class="flex gap-6">
          <div class="text-center">
            <div class="text-3xl font-bold text-primary"><%= @owned_count %></div>
            <div class="text-sm text-base-content/60">Owned</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-secondary"><%= @wishlist_count %></div>
            <div class="text-sm text-base-content/60">Wishlist</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-accent"><%= current_user.paints.distinct.joins(product_line: :brand).select('brands.id').distinct.count %></div>
            <div class="text-sm text-base-content/60">Brands</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation Bar -->
  <div class="sticky top-0 z-40 bg-base-100/80 backdrop-blur-xl border-b border-base-200 -mx-4 px-4 mb-8"  data-controller="toggle" >
    <div class="flex items-center justify-between py-4">
      <!-- Status Tabs -->
      <div class="flex items-center gap-1 bg-base-200 rounded-full p-1">
        <%= link_to user_paints_path(color: params[:color], status: nil),
                class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{params[:status] == 'all' || params[:status].blank? ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
          All <span class="ml-1 opacity-60">(<%= @all_count %>)</span>
        <% end %>
        <%= link_to user_paints_path(color: params[:color], status: :owned),
                class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{params[:status] == 'owned' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
          Owned <span class="ml-1 opacity-60">(<%= @owned_count %>)</span>
        <% end %>
        <%= link_to user_paints_path(color: params[:color], status: :wishlist),
                class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{params[:status] == 'wishlist' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
          Wishlist <span class="ml-1 opacity-60">(<%= @wishlist_count %>)</span>
        <% end %>
        <%= link_to user_paints_path(color: params[:color], status: :avoid),
                class: "px-4 py-2 rounded-full text-sm font-medium transition-all #{params[:status] == 'avoid' ? 'bg-primary text-primary-content shadow-sm' : 'text-base-content/60 hover:text-base-content'}" do %>
          Avoid <span class="ml-1 opacity-60">(<%= @avoid_count %>)</span>
        <% end %>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <button class="btn btn-ghost btn-sm"data-action="click->toggle#toggle">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          <span class="hidden sm:inline">Filter</span>
        </button>

        <div class="dropdown dropdown-end">
          <label tabindex="0" class="btn btn-ghost btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
            </svg>
            <span class="hidden sm:inline">More</span>
          </label>
          <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-lg bg-base-100 rounded-box w-52 border border-base-200">
            <li>
              <%= link_to bulk_import_user_paints_path do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
                </svg>
                Bulk Import
              <% end %>
            </li>
            <li>
              <%= link_to color_wheel_user_paints_path do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
                Color Wheel
              <% end %>
            </li>
          </ul>
        </div>

        <%= link_to new_user_paint_path, class: "btn btn-primary btn-sm", data: { turbo_frame: "modal" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span class="hidden sm:inline ml-2">Add Paint</span>
        <% end %>
      </div>
    </div>

    <!-- Collapsible Filter Section -->
    <%= turbo_frame_tag "collection-filters" do %>
      <div data-toggle-target="content" class="hidden pb-4">
        <div class="bg-base-50 rounded-2xl p-6 border border-base-200">
          <%= render "shared/filter_form",
              q: @q,
              url: user_paints_path,
              turbo_frame: "collection-results",
              brands: @brands,
              product_lines: @product_lines,
              color_categories: @color_categories,
              clear_url: user_paints_path(status: params[:status]),
              brand_field: :paint_product_line_brand_id_eq,
              product_line_field: :paint_product_line_id_eq %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Paint Collection Grid -->
  <%= turbo_frame_tag "collection-results" do %>
    <% if @user_paints.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5 gap-6">
        <% @user_paints.each do |user_paint| %>
          <%= render 'user_paints/modern_paint_card', user_paint: user_paint %>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="flex flex-col items-center justify-center py-20">
        <div class="w-32 h-32 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-full flex items-center justify-center mb-8">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>

        <h2 class="text-3xl font-bold mb-4">
          <% if params[:q].present? || params[:color].present? %>
            No matches found
          <% else %>
            <%= case params[:status]
                when 'owned', nil
                  "Start your collection"
                when 'wishlist'
                  "Build your wishlist"
                when 'avoid'
                  "No paints to avoid"
                else
                  "No paints found"
                end %>
          <% end %>
        </h2>

        <p class="text-base-content/60 text-center max-w-md mb-8">
          <% if params[:q].present? || params[:color].present? %>
            Try adjusting your filters or search terms to find what you're looking for.
          <% else %>
            <%= case params[:status]
                when 'owned', nil
                  "Add your first paint to start building your collection. Track what you own, discover new colors, and organize your hobby."
                when 'wishlist'
                  "Found a paint you want? Add it to your wishlist so you never forget what to buy next."
                when 'avoid'
                  "Keep track of paints you want to avoid for any reason."
                else
                  "Start exploring and building your paint collection."
                end %>
          <% end %>
        </p>

        <div class="flex gap-4">
          <% if params[:q].present? || params[:color].present? %>
            <%= link_to "Clear Filters", user_paints_path(status: params[:status]),
                class: "btn btn-outline" %>
          <% end %>
          <%= link_to new_user_paint_path,
              class: "btn btn-primary",
              data: { turbo_frame: "modal" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Add Your First Paint
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<%= turbo_frame_tag "modal" %>
