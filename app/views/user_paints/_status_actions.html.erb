<!-- Mobile-First Status Actions -->
<div class="flex items-center justify-end gap-1 sm:gap-2">
  <!-- Status Transitions -->
  <% status_transitions(user_paint.status).each do |transition| %>
    <%= button_to user_paint_path(user_paint),
        method: :patch,
        params: { user_paint: { status: transition[:status] }, quick_action: true },
        class: "btn #{transition[:class]} btn-xs sm:btn-sm border-0 shadow-sm hover:shadow-md transition-all duration-200",
        form: { class: "inline-block" },
        title: transition[:tooltip],
        data: {
          turbo: false,
        } do %>

      <!-- Mobile: Icon only -->
      <span class="sm:hidden">
        <%= status_icon(transition[:icon], "h-3 w-3") %>
      </span>

      <!-- Desktop: Icon + Text -->
      <span class="hidden sm:flex items-center gap-1.5">
        <%= status_icon(transition[:icon], "h-3.5 w-3.5") %>
        <span class="text-xs font-medium"><%= transition[:short_label] %></span>
      </span>
    <% end %>
  <% end %>

  <!-- Edit Action -->
  <%= link_to edit_user_paint_path(user_paint),
      data: { turbo_frame: "modal" },
      class: "btn btn-ghost btn-xs sm:btn-sm border border-base-300 hover:border-primary hover:bg-primary/10 transition-all duration-200",
      title: "Edit paint details" do %>

    <!-- Mobile: Icon only -->
    <span class="sm:hidden">
      <%= status_icon("edit", "h-3 w-3") %>
    </span>

    <!-- Desktop: Icon + Text -->
    <span class="hidden sm:flex items-center gap-1.5">
      <%= status_icon("edit", "h-3.5 w-3.5") %>
      <span class="text-xs font-medium">Edit</span>
    </span>
  <% end %>

  <!-- Separator -->
  <div class="w-px h-4 bg-base-300 mx-1 hidden sm:block"></div>

  <!-- Remove Action -->
  <%= button_to user_paint_path(user_paint),
      method: :delete,
      data: {
        turbo_confirm: "Remove this paint from your collection?",
        turbo_frame: "_top",
        status_actions_target: "deleteButton"
      },
      class: "btn btn-ghost btn-xs sm:btn-sm text-error hover:bg-error/10 hover:border-error border border-transparent transition-all duration-200",
      form: { class: "inline-block" },
      title: "Remove from collection" do %>

    <!-- Mobile: Icon only -->
    <span class="sm:hidden">
      <%= status_icon("trash", "h-3 w-3") %>
    </span>

    <!-- Desktop: Icon + Text -->
    <span class="hidden sm:flex items-center gap-1.5">
      <%= status_icon("trash", "h-3.5 w-3.5") %>
      <span class="text-xs font-medium">Remove</span>
    </span>
  <% end %>
</div>

<!-- Loading state overlay -->
<div class="hidden absolute inset-0 bg-base-100/50 backdrop-blur-sm rounded-lg flex items-center justify-center" data-status-actions-target="loading">
  <div class="loading loading-spinner loading-sm text-primary"></div>
</div>
