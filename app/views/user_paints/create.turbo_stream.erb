<% if @search_term.present? %>
  <%= turbo_stream.replace "search-term-row-#{@search_term}" do %>
    <tr id="search-term-row-<%= @search_term %>" class="search-term-row bg-success bg-opacity-20">
      <td class="font-medium"><%= @user_paint.paint.name %></td>
      <td><span class="text-success font-semibold">Added to your <%= @user_paint.status %> ✓</span></td>
      <td>
        <div class="flex gap-2">
          <span class="badge badge-<%= @user_paint.status == 'owned' ? 'success' : 'info' %> badge-lg">
            Added to <%= @user_paint.status.titleize %>
          </span>
        </div>
      </td>
    </tr>
  <% end %>
<% else %>
  <%# Regular paint addition - update dashboard components %>
  <%# Add the new paint to the recent additions on dashboard %>
  <%= turbo_stream.prepend "recent-paints" do %>
    <%= render "dashboard/recent_paint_item", user_paint: @user_paint %>
  <% end %>

  <%# Update the dashboard stats %>
  <%= turbo_stream.replace "dashboard-stats" do %>
    <%= render "dashboard/stats" %>
  <% end %>

  <%# Update the paint in search results if present %>
  <% paint_id = @user_paint.paint_id %>
<% end %>
<%= turbo_stream.prepend "collection-results-grid-all", partial: "modern_paint_card", locals: { user_paint: @user_paint } %>
<%= turbo_stream.prepend "collection-results-grid-#{@user_paint.status}", partial: "modern_paint_card", locals: { user_paint: @user_paint } %>
<%= render "user_paints/rack_counts_stream" %>

<%# Update the collection options section on paint show page %>
<%= turbo_stream.replace "collection-options-#{paint_id}" do %>
  <%= render "paints/collection_options", paint: @user_paint.paint, user_paint: @user_paint %>
<% end %>

<%# Update the status badge in the hero section %>
<%= turbo_stream.replace "status-badge-#{paint_id}" do %>
  <%= render "paints/status_badge", paint: @user_paint.paint, user_paint: @user_paint %>
<% end %>

<%# Update the notes section %>
<%= turbo_stream.replace "notes-section-#{paint_id}" do %>
  <%= render "paints/notes_section", paint: @user_paint.paint, user_paint: @user_paint %>
<% end %>

<%# Replace the paint card in all similar paints sections %>
<% ["rgb", "hsl", "user"].each do |type| %>
  <%= turbo_stream.replace "similar-paint-#{paint_id}" do %>
    <div id="similar-paint-<%= paint_id %>" class="similar-paint-item">
      <%= render "paints/similar_paint_card", user_paint: @user_paint %>
    </div>
  <% end %>
<% end %>

<%# Update the paint in search results %>
<%= turbo_stream.replace "search-result-#{paint_id}" do %>
  <div id="search-result-<%= paint_id %>" class="search-result-item">
    <%= render "paints/search_result", user_paint: @user_paint %>
  </div>
<% end %>

<%# Update the paint in paints index if present %>
<%= turbo_stream.replace "paint-card-#{paint_id}", partial: "paints/modern_catalog_card", locals: { user_paint: @user_paint } %>

<%# Flash a success notice %>
<%= turbo_stream.prepend "flash-messages" do %>
  <div role="status" class="panel flex items-start gap-3 px-4 py-3 border-base-content">
    <%= ph_icon(:check, size: 18, stroke: 2.4, css: "shrink-0 mt-0.5") %>
    <p class="flex-1 text-sm font-medium">Added to your rack as <%= status_label(@user_paint.status) %>.</p>
    <button type="button" aria-label="Dismiss" class="shrink-0 opacity-70 hover:opacity-100" onclick="this.parentElement.remove()"><%= ph_icon(:x, size: 16) %></button>
  </div>
<% end %>
