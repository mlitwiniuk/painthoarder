<div id="stats-grid" class="grid grid-cols-4 gap-2 sm:gap-4 mb-6 sm:mb-8">
  <div class="bg-base-100 border border-base-200 rounded-lg p-3 sm:p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-[10px] sm:text-sm text-base-content/60 uppercase tracking-wide font-medium mb-1">Owned</div>
    <div class="text-lg sm:text-2xl font-bold text-primary"><%= @owned_count %></div>
  </div>

  <div class="bg-base-100 border border-base-200 rounded-lg p-3 sm:p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-[10px] sm:text-sm text-base-content/60 uppercase tracking-wide font-medium mb-1">Wishlist</div>
    <div class="text-lg sm:text-2xl font-bold text-secondary"><%= @wishlist_count %></div>
  </div>

  <div class="bg-base-100 border border-base-200 rounded-lg p-3 sm:p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-[10px] sm:text-sm text-base-content/60 uppercase tracking-wide font-medium mb-1">Brands</div>
    <div class="text-lg sm:text-2xl font-bold text-accent"><%= current_user.paints.distinct.joins(product_line: :brand).select('brands.id').distinct.count %></div>
  </div>

  <div class="bg-base-100 border border-base-200 rounded-lg p-3 sm:p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-[10px] sm:text-sm text-base-content/60 uppercase tracking-wide font-medium mb-1">Total</div>
    <div class="text-lg sm:text-2xl font-bold text-info"><%= @all_count %></div>
  </div>
</div>
