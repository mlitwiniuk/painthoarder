<div id="<%= dom_id(user_paint) %>" class="group relative bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 hover:border-gray-200">
  <!-- Paint Color Preview - Hero Section -->
  <div class="relative aspect-square overflow-hidden">
    <!-- Main Color Display -->
    <div class="absolute inset-0 transition-transform duration-300 group-hover:scale-105"
         style="background: linear-gradient(135deg, <%= user_paint.paint.hex_color %> 0%, <%= user_paint.paint.hex_color %>dd 100%);">
      <!-- Subtle overlay for better text readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent"></div>
    </div>

    <!-- Status Badge -->
    <div class="absolute top-3 left-3 z-10">
      <% case user_paint.status %>
      <% when 'owned' %>
        <div class="bg-green-500 text-white px-3 py-1 rounded-full text-xs font-medium shadow-lg backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Owned
        </div>
      <% when 'wishlist' %>
        <div class="bg-amber-500 text-white px-3 py-1 rounded-full text-xs font-medium shadow-lg backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          Want
        </div>
      <% when 'avoid' %>
        <div class="bg-red-500 text-white px-3 py-1 rounded-full text-xs font-medium shadow-lg backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
          Avoid
        </div>
      <% end %>
    </div>

    <!-- Quick Actions Menu -->
    <div class="absolute top-3 right-3 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-200">
      <div class="dropdown dropdown-end">
        <label tabindex="0" class="btn btn-ghost btn-sm btn-circle bg-white/90 hover:bg-white text-gray-700 shadow-lg backdrop-blur-sm">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
          </svg>
        </label>
        <ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow-xl bg-white rounded-xl w-44 border border-gray-200">
          <li>
            <%= link_to user_paint_path(user_paint), data: { turbo_frame: "_top" }, class: "text-gray-700 hover:bg-gray-50" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              View Details
            <% end %>
          </li>
          <li>
            <%= link_to edit_user_paint_path(user_paint), data: { turbo_frame: "modal" }, class: "text-gray-700 hover:bg-gray-50" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              Edit
            <% end %>
          </li>
          <li>
            <%= button_to user_paint_path(user_paint), method: :delete,
                data: { turbo_confirm: "Remove this paint from your collection?" },
                class: "flex items-center w-full text-red-600 hover:bg-red-50" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
              Remove
            <% end %>
          </li>
        </ul>
      </div>
    </div>

    <!-- Color Harmony Indicator (subtle dots) -->
    <div class="absolute bottom-3 left-3 flex gap-1">
      <div class="w-2 h-2 rounded-full bg-white/40 backdrop-blur-sm"></div>
      <div class="w-2 h-2 rounded-full bg-white/30 backdrop-blur-sm"></div>
      <div class="w-2 h-2 rounded-full bg-white/20 backdrop-blur-sm"></div>
    </div>
  </div>

  <!-- Paint Information -->
  <div class="p-4">
    <!-- Paint Name & Brand -->
    <%= link_to user_paint_path(user_paint), data: { turbo_frame: "_top" }, class: "block group/link" do %>
      <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover/link:text-primary transition-colors line-clamp-1">
        <%= user_paint.paint.name %>
      </h3>
      <div class="flex items-center text-sm text-gray-500 mb-3">
        <span class="font-medium"><%= user_paint.paint.product_line.brand.name %></span>
        <span class="mx-2">•</span>
        <span><%= user_paint.paint.product_line.name %></span>
      </div>
    <% end %>

    <!-- Metadata Row -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <!-- Hex Color Code -->
        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs font-mono rounded-lg">
          <%= user_paint.paint.hex_color %>
        </span>

        <!-- Purchase Date -->
        <% if user_paint.purchase_date.present? %>
          <span class="text-xs text-gray-400">
            <%= user_paint.purchase_date.strftime("%b %Y") %>
          </span>
        <% end %>
      </div>

      <% if false %>
        <!-- Heart/Like Button (placeholder for future social features) -->
        <button class="opacity-0 group-hover:opacity-100 transition-opacity p-1 hover:bg-gray-100 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-400 hover:text-red-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </button>
      <% end %>
    </div>
  </div>

  <!-- Hover Overlay for Enhanced Interactivity -->
  <div class="absolute inset-0 bg-gradient-to-t from-transparent via-transparent to-black/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
</div>
