<%# Rack card: swatch with status tag, name wraps to two lines, brand · range. %>
<% paint = user_paint.paint %>
<%= link_to user_paint_path(user_paint), id: dom_id(user_paint), class: "paint-card",
      data: { turbo_frame: "_top" } do %>
  <div class="paint-card-swatch h-[86px] sm:h-30" style="<%= paint_swatch_style(paint) %>">
    <%= status_tag(user_paint.status, size: :sm, css: "absolute top-1.5 left-1.5 sm:top-2.5 sm:left-2.5") %>
  </div>
  <div class="flex flex-col gap-1 px-2.5 pt-2 pb-2.5 sm:px-3.5 sm:pt-3 sm:pb-3.5">
    <span class="paint-card-name text-[17px] sm:text-[21px]"><%= paint.name %></span>
    <span class="text-xs sm:text-[13px] text-muted"><%= paint.product_line.brand.name %> · <%= paint.product_line.name %></span>
  </div>
<% end %>
