<%# Status- and search-specific empty states for the rack. %>
<% search = params[:search].to_s.strip %>
<% filtered = search.present? || params[:color].present? || params.dig(:q, :paint_product_line_brand_id_eq).present? || params.dig(:q, :paint_product_line_id_eq).present? %>
<%
  title, body, cta =
    if search.present?
      ["Not on your rack",
        "No paints in your rack match “#{search}”. It might be in the catalogue, and you can mark it Owned or Wanted from there.",
        :search_catalogue]
    elsif filtered
      ["Nothing matches",
        "No paints in your rack match these filters. Try another brand, range or colour.",
        :catalogue]
    else
      case params[:status]
      when "wishlist"
        ["Nothing on the wishlist", "Mark paints as Wanted from the catalogue and they show up here as a shopping list.", :catalogue]
      when "avoid"
        ["No paints to avoid", "Tried something you hated? Mark it Avoid so you never buy it twice.", :catalogue]
      else
        ["Start your collection", "Add the paints you own, or import a typed list or a photo of your shelf.", :add]
      end
    end
%>
<div class="panel-dashed px-6 py-10 sm:px-8 sm:py-12 flex flex-col items-start gap-3">
  <h2 class="section-title"><%= title %></h2>
  <p class="text-base text-soft max-w-[520px]"><%= body %></p>
  <div class="flex flex-wrap gap-2.5 mt-2">
    <% case cta %>
    <% when :search_catalogue %>
      <%= link_to "Search catalogue for “#{search}”", paints_path(search: search), class: "btn btn-primary", data: { turbo_frame: "_top" } %>
    <% when :catalogue %>
      <%= link_to "Browse catalogue", paints_path, class: "btn btn-primary", data: { turbo_frame: "_top" } %>
    <% when :add %>
      <%= link_to new_user_paint_path, class: "btn btn-primary", data: { turbo_frame: "modal" } do %>
        <%= ph_icon(:plus, size: 18, stroke: 2.6) %>Add your first paint
      <% end %>
      <%= link_to "Import paints", bulk_import_user_paints_path, class: "btn btn-outline", data: { turbo_frame: "_top" } %>
    <% end %>
    <% if filtered || params[:status].present? %>
      <%= link_to "Show whole rack", user_paints_path, class: "btn btn-outline", data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
</div>
