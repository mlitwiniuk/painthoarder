<%# Existing rack paints get the one-step editor; new ones pick brand → range → paint first. %>
<% if @user_paint.persisted? %>
  <%= render "user_paints/edit_form" %>
<% else %>
<%= turbo_frame_tag "modal" do %>
  <div
    class="modal modal-open"
    data-controller="modal multi-step-form cascading-select color-preview"
    data-cascading-select-brand-id-value="<%= @user_paint.paint&.product_line&.brand_id %>"
    data-cascading-select-product-line-id-value="<%= @user_paint.paint&.product_line_id %>"
    data-cascading-select-paint-id-value="<%= @user_paint.paint_id %>"
    data-multi-step-form-current-step-value="0"
    data-action="
      click->modal#closeBackground
      keyup@window->modal#closeWithKeyboard
    "
  >

    <div
      class="
        modal-box max-w-md sm:max-w-2xl h-full sm:h-auto sm:max-h-[90vh] p-0
        overflow-hidden bg-base-100 border-2 border-line-strong rounded shadow-none
      "
    >
      <!-- Header -->
      <div class="sticky top-0 bg-base-100 border-b-2 border-line p-4 sm:p-6">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <button
              type="button"
              class="btn btn-ghost btn-square sm:hidden"
              data-multi-step-form-target="backButton"
              data-action="click->multi-step-form#previousStep"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"
                ></path>
              </svg>
            </button>
            <div>
              <h2 class="cond font-black text-[30px] leading-none">
                Add paint
              </h2>
              <p class="text-sm text-muted mt-1" data-multi-step-form-target="stepTitle">
                Choose your brand
              </p>
            </div>
          </div>
          <button
            type="button"
            class="btn btn-ghost btn-square"
            aria-label="Close"
            data-action="click->modal#close"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              ></path>
            </svg>
          </button>
        </div>
        <!-- Progress Bar -->
        <div class="mt-4">
          <div
            class="
              flex items-center justify-between font-mono text-[11px] uppercase text-muted mb-2
            "
          >
            <span>Step
              <span data-multi-step-form-target="currentStepNumber">1</span>
              of 4</span>
            <span><span data-multi-step-form-target="progressPercent">25</span>%</span>
          </div>
          <div class="w-full bg-base-200 h-1.5">
            <div
              class="bg-primary h-1.5 transition-all duration-300"
              data-multi-step-form-target="progressBar"
              style="width: 25%"
            ></div>
          </div>
        </div>
      </div>

      <%= form_with(model: @user_paint, data: {
        controller: "form-submission",
        action: "turbo:submit-end->modal#handleSubmit turbo:submit-end->multi-step-form#handleSubmit"
      }) do |form| %>
        <!-- Error Display -->
        <% if @user_paint.errors.any? %>
          <div role="alert" class="flex gap-3 items-start mx-4 sm:mx-6 mt-4 px-3.5 py-3 border-2 border-avoid rounded text-sm">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-5 w-5 text-avoid"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <div>
              <h3 class="font-semibold">Fix this and you’re in:</h3>
              <ul class="mt-1 list-disc list-inside">
                <% @user_paint.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        <% end %>

        <div class="overflow-y-auto flex-1 px-4 sm:px-6 pb-20">
          <!-- Step 1: Brand Selection -->
          <div class="step-content" data-multi-step-form-target="step" data-step="0">
            <div class="py-6">
              <div class="mb-6">
                <label class="block text-sm font-semibold mb-2">
                  Select a brand
                </label>
                <div class="space-y-2">
                  <select
                    id="brand_id"
                    class="select w-full text-base"
                    data-cascading-select-target="brandSelect"
                    data-multi-step-form-target="brandSelect"
                    data-action="
                      change->cascading-select#brandChanged
                      change->multi-step-form#brandChanged
                    "
                  >
                    <option value="">Choose a brand...</option>
                    <% @brands.each do |brand| %>
                      <option
                        value="<%= brand.id %>"
                        <%= 'selected' if @user_paint.paint&.product_line&.brand_id == brand.id %>
                      >
                        <%= brand.name %>
                      </option>
                    <% end %>
                  </select>
                </div>
              </div>
            </div>
          </div>
          <!-- Step 2: Product Line Selection -->
          <div
            class="step-content hidden"
            data-multi-step-form-target="step"
            data-step="1"
          >
            <div class="py-6">
              <div class="mb-6">
                <label class="block text-sm font-semibold mb-2">
                  Select a product line
                </label>
                <select
                  id="product_line_id"
                  class="select w-full text-base"
                  data-cascading-select-target="productLineSelect"
                  data-multi-step-form-target="productLineSelect"
                  data-action="
                    change->cascading-select#productLineChanged
                    change->multi-step-form#productLineChanged
                  "
                  disabled
                >
                  <option value="">Choose a product line...</option>
                  <% @product_lines.each do |product_line| %>
                    <option
                      value="<%= product_line.id %>"
                      <%= 'selected' if @user_paint.paint&.product_line_id == product_line.id %>
                    >
                      <%= product_line.name %>
                    </option>
                  <% end %>
                </select>
              </div>
            </div>
          </div>
          <!-- Step 3: Paint Selection -->
          <div
            class="step-content hidden"
            data-multi-step-form-target="step"
            data-step="2"
          >
            <div class="py-6">
              <div class="mb-6">
                <label class="block text-sm font-semibold mb-2">
                  Select a paint
                </label>
                <select
                  id="user_paint_paint_id"
                  name="user_paint[paint_id]"
                  class="select w-full text-base"
                  data-cascading-select-target="paintSelect"
                  data-multi-step-form-target="paintSelect"
                  data-action="
                    change->color-preview#updatePreview
                    change->multi-step-form#paintChanged
                  "
                  disabled
                  required
                >
                  <option value="">Choose a paint...</option>
                  <% @paints.each do |paint| %>
                    <option
                      value="<%= paint.id %>"
                      data-color="<%= paint.hex_color %>"
                      <%= 'selected' if @user_paint.paint_id == paint.id %>
                    >
                      <%= paint.name %>
                      (<%= paint.code %>)
                    </option>
                  <% end %>
                </select>
              </div>
              <!-- Color Preview -->
              <div
                class="panel p-4 mb-4"
                data-color-preview-target="previewContainer"
              >
                <div class="flex items-center space-x-4">
                  <div
                    class="
                      w-16 h-16 rounded border border-line-strong flex-shrink-0
                    "
                    data-color-preview-target="colorSwatch"
                  ></div>
                  <div class="flex-1">
                    <div class="cond font-extrabold text-xl leading-tight" data-color-preview-target="paintName">Paint Preview</div>
                    <div class="font-mono text-xs text-muted" data-color-preview-target="colorCode"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Step 4: Details -->
          <div
            class="step-content hidden"
            data-multi-step-form-target="step"
            data-step="3"
          >
            <div class="py-6 space-y-6">
              <%= render "user_paints/status_radio_cards", user_paint: @user_paint, wizard: true %>
              <!-- Notes -->
              <div class="form-control">
                <label class="block text-sm font-semibold mb-2">
                  Notes (optional)
                </label>
                <%= form.text_area :notes,
                               rows: 3,
                               class: "textarea w-full text-base",
                               placeholder: "Add any notes about this paint..." %>
              </div>
              <!-- Purchase Details (Collapsible) -->
              <div class="collapse collapse-arrow border-2 border-line rounded" data-controller="collapse">
                <input
                  type="checkbox"
                  data-collapse-target="toggle"
                  data-action="change->collapse#toggle"
                >
                <div class="collapse-title text-sm font-semibold">
                  Purchase details <span class="font-normal text-muted">(optional, only you see these)</span>
                </div>
                <div class="collapse-content">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text text-[13px] font-semibold text-base-content">When</span>
                      </label>
                      <%= form.date_field :purchase_date, class: "input w-full" %>
                    </div>
                    <div class="form-control">
                      <label class="label">
                        <span class="label-text text-[13px] font-semibold text-base-content">Price</span>
                      </label>
                      <%= form.number_field :purchase_price, step: 0.01, min: 0, inputmode: "decimal", class: "input w-full" %>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
        <!-- Footer Actions -->
        <div class="sticky bottom-0 bg-base-100 border-t-2 border-line p-4 sm:p-6">
          <div class="flex items-center justify-between space-x-3">
            <button
              type="button"
              class="btn btn-outline hidden sm:flex"
              data-multi-step-form-target="prevButton"
              data-action="click->multi-step-form#previousStep"
            >
              Previous
            </button>

            <button
              type="button"
              class="btn btn-outline sm:hidden"
              data-action="click->modal#close"
            >
              Cancel
            </button>

            <div class="flex space-x-3">
              <button
                type="button"
                class="btn btn-primary"
                data-multi-step-form-target="nextButton"
                data-action="click->multi-step-form#nextStep"
              >
                Next
              </button>

              <button
                type="submit"
                class="btn btn-primary hidden"
                data-multi-step-form-target="submitButton"
              >
                Add to rack
              </button>
            </div>
          </div>
        </div>

      <% end %>
    </div>

    <div class="modal-backdrop"></div>
  </div>
<% end %>
<% end %>
