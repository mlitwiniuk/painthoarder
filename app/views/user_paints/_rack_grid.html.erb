<% if user_paints.any? %>
  <div id="collection-results-grid-<%= @status || 'all' %>"
       class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-2.5 sm:gap-4">
    <% user_paints.each do |user_paint| %>
      <%= render "user_paints/modern_paint_card", user_paint: user_paint %>
    <% end %>
  </div>
<% else %>
  <%= render "user_paints/no_paints" %>
<% end %>
