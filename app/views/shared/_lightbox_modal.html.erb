<div id="lightbox-modal" class="modal">
  <% if user_signed_in? %>
    <div class="modal-box p-0 relative max-w-7xl max-h-[90vh] w-auto overflow-hidden bg-transparent shadow-none">
      <button class="btn btn-circle absolute top-2 right-2 z-10" onclick="document.getElementById('lightbox-modal').classList.remove('modal-open')">&#x2715;</button>
      <button id="lightbox-prev" class="btn btn-circle absolute left-2 top-1/2 z-10">&#x276E;</button>
      <button id="lightbox-next" class="btn btn-circle absolute right-2 top-1/2 z-10">&#x276F;</button>
      <img id="lightbox-image" class="max-h-[90vh] max-w-full w-auto h-auto object-contain mx-auto" alt="Project image" />
    </div>
  <% else %>
    <div class="modal-box relative max-w-lg text-center">
      <button class="btn btn-circle btn-sm absolute top-3 right-3" onclick="document.getElementById('lightbox-modal').classList.remove('modal-open')">&#x2715;</button>
      <div class="py-4">
        <div class="mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-base-content mb-2">Want to see more?</h3>
        <p class="text-base-content/70 mb-6">Sign in or create a free account to view full-resolution images and explore more projects.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <%= link_to "Get Started", new_user_registration_path, class: "btn btn-primary" %>
          <%= link_to "Sign In", new_user_session_path, class: "btn btn-ghost" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
