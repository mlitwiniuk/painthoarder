<% paint = @user_paint.paint %>
<% line = paint.product_line %>
<% brand = line.brand %>
<% related = paint_related(paint, @user_paint) %>
<% content_for :title, "#{paint.name} | PaintHoarder" %>

<div class="flex flex-col gap-12 <%= "pb-40 lg:pb-0" if user_signed_in? %>">
  <nav aria-label="Breadcrumb" class="text-sm text-muted flex flex-wrap gap-2 -mt-2">
    <% if back_url == user_paints_path %>
      <%= link_to "My rack", user_paints_path, class: "text-soft hover:text-accent-text" %><span aria-hidden="true">/</span>
    <% end %>
    <%= link_to "Catalogue", paints_path, class: "text-soft hover:text-accent-text" %><span aria-hidden="true">/</span>
    <%= link_to brand.name, brand_path(brand), class: "text-soft hover:text-accent-text" %><span aria-hidden="true">/</span>
    <%= link_to line.name, brand_product_line_path(brand, line), class: "text-soft hover:text-accent-text" %>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-start">
    <div class="flex flex-col gap-3">
      <div class="aspect-[1.25] rounded border-2 border-line" style="<%= paint_swatch_style(paint) %>"></div>
      <div class="font-mono flex flex-wrap gap-5 text-xs text-muted">
        <% if paint.color_known? %>
          <span>HEX <%= paint.hex_color %></span>
          <span>RGB <%= paint.red %> <%= paint.green %> <%= paint.blue %></span>
        <% else %>
          <span>Swatch unknown. Colour matching is unavailable for this paint.</span>
        <% end %>
        <% if paint.code.present? && paint.code != paint.name %>
          <span>CODE <%= paint.code %></span>
        <% end %>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-2.5 items-start">
        <span class="tag tag-lg tag-range"><%= brand.name %> · <%= line.name %></span>
        <h1 class="page-title text-[clamp(2.75rem,8vw,5.5rem)]"><%= paint.name %></h1>
        <% if related[:also_in].any? %>
          <p class="text-[15px] text-soft">
            Also in this colour:
            <% related[:also_in].each_with_index do |other, i| %><%= " · " if i.positive? %><%= link_to other.product_line.name, directory_paint_path_for(other), class: "font-semibold hover:text-accent-text" %><% end %>
          </p>
        <% end %>
      </div>

      <%= render "paints/collection_options", paint: paint, user_paint: @user_paint %>

      <% stats = paint.collection_stats %>
      <% if stats[:owned].positive? || stats[:wishlist].positive? || related[:tutorial_count].positive? %>
        <div class="flex flex-wrap gap-7 text-sm text-soft">
          <span><b class="text-base-content text-lg"><%= number_with_delimiter(stats[:owned]) %></b> <%= stats[:owned] == 1 ? "painter owns" : "painters own" %> it</span>
          <span><b class="text-base-content text-lg"><%= number_with_delimiter(stats[:wishlist]) %></b> want it</span>
          <% if related[:tutorial_count].positive? %>
            <span><b class="text-base-content text-lg"><%= number_with_delimiter(related[:tutorial_count]) %></b> <%= "tutorial".pluralize(related[:tutorial_count]) %> use it</span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <section class="flex flex-col gap-4" data-controller="similar-tabs">
    <div class="flex flex-wrap justify-between items-end gap-3 border-b-2 border-line pb-3.5">
      <h2 class="section-title">Swap it for another brand</h2>
      <div role="tablist" aria-label="Match by" class="flex gap-1.5">
        <button type="button" role="tab" class="chip" aria-selected="true" aria-controls="color-content"
                data-similar-tabs-target="tab" data-tab="color" data-action="click->similar-tabs#switch">Closest colour</button>
        <button type="button" role="tab" class="chip" aria-selected="false" aria-controls="hue-content"
                data-similar-tabs-target="tab" data-tab="hue" data-action="click->similar-tabs#switch">Same hue family</button>
      </div>
    </div>

    <div id="color-content" role="tabpanel" data-similar-tabs-target="content">
      <%= turbo_frame_tag "similar-paints-frame-color",
            src: similar_paint_path(paint, similar_type: "color", per_page: 12, format: :html), loading: "lazy" do %>
        <p class="py-10 text-center text-sm text-muted"><span class="loading loading-spinner loading-sm mr-2"></span>Finding close matches…</p>
      <% end %>
    </div>
    <div id="hue-content" role="tabpanel" class="hidden" data-similar-tabs-target="content">
      <%= turbo_frame_tag "similar-paints-frame-hue",
            src: similar_paint_path(paint, similar_type: "hue", per_page: 12, format: :html), loading: "lazy" do %>
        <p class="py-10 text-center text-sm text-muted"><span class="loading loading-spinner loading-sm mr-2"></span>Finding the hue family…</p>
      <% end %>
    </div>
  </section>

  <% if related[:video_mentions].any? || related[:project_usages].any? %>
    <section class="flex flex-col gap-4">
      <h2 class="section-title border-b-2 border-line pb-3.5">Used in</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-4">
        <% related[:video_mentions].each do |video, mentions| %>
          <% matched = video.video_paints.filter_map(&:paint_id).uniq %>
          <% stamps = video_timestamps(mentions) %>
          <%= link_to video_path(video), class: "panel no-underline p-4 flex flex-col gap-2 hover:border-line-strong" do %>
            <span class="eyebrow text-[11px]">Video<%= " · at #{stamps}" if stamps.present? %></span>
            <b class="card-title-cond text-[22px]"><%= video.title.presence || "Untitled tutorial" %></b>
            <% if user_signed_in? && matched.any? %>
              <span class="text-[13px] text-soft"><%= matched.count { |id| related[:owned_paint_ids].include?(id) } %> of <%= matched.size %> paints on your rack</span>
            <% end %>
          <% end %>
        <% end %>
        <% related[:project_usages].each do |project, usages| %>
          <%= link_to project_path(project), class: "panel no-underline p-4 flex flex-col gap-2 hover:border-line-strong" do %>
            <span class="eyebrow text-[11px]">Your project</span>
            <b class="card-title-cond text-[22px]"><%= project.title %></b>
            <span class="text-[13px] text-soft">Used in <%= usages.map { |u| u.project_update.title.presence }.compact.uniq.first(2).join(", ").presence || pluralize(usages.size, "update") %></span>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
