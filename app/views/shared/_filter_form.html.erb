<%= search_form_for q, url: url, method: :get,
    data: { turbo_frame: turbo_frame, turbo_action: "advance", controller: "auto-submit" } do |f| %>
  <div class="space-y-3 lg:space-y-4">
    <!-- Search Input - Full width on mobile, part of grid on desktop -->
    <div class="form-control lg:col-span-4">

      <%= text_field_tag :search, params[:search],
            placeholder: "Search paints...",
            class: "input input-sm lg:input-md input-bordered w-full",
            data: { action: "input->auto-submit#debouncedSubmit" } %>
    </div>

    <!-- Filters Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 lg:gap-4">
      <!-- Brand Filter -->
      <div class="form-control">

        <%= f.select defined?(brand_field) ? brand_field : :product_line_brand_id_eq,
              brands.map { |b| [b.name, b.id] },
              { include_blank: "All Brands" },
              class: "select select-sm lg:select-md select-bordered w-full text-xs lg:text-sm",
              data: { action: "change->auto-submit#debouncedSubmit" } %>
      </div>

      <!-- Product Line Filter -->
           <div class="form-control lg:col-span-1">

             <%= f.select defined?(product_line_field) ? product_line_field : :product_line_id_eq,
                   product_lines.map { |pl| ["#{pl.brand.name} - #{pl.name}", pl.id] },
                   { include_blank: "All Product Lines" },
                   class: "select select-sm lg:select-md select-bordered w-full text-xs lg:text-sm",
                   data: { action: "change->auto-submit#debouncedSubmit" } %>
           </div>

      <!-- Color Filter -->
      <div class="form-control">

        <%= select_tag :color,
              options_for_select(color_categories, params[:color]),
              include_blank: "All Colors",
              class: "select select-sm lg:select-md select-bordered w-full text-xs lg:text-sm",
              data: { action: "change->auto-submit#debouncedSubmit" } %>
      </div>


      <!-- Clear Button -->
      <div class="form-control lg:col-span-1 flex items-center justify-end">
        <button type="button" class="btn btn-ghost btn-sm lg:btn-md text-xs lg:text-sm w-full lg:w-auto " data-action="click->auto-submit#clearFilters">
          <span class="lg:hidden">Clear</span>
          <span class="hidden lg:inline">Clear Filters</span>
        </button>
      </div>
    </div>
  </div>


  <%# Hidden field to track if we're clearing filters %>
  <%= hidden_field_tag :clear_filters, "", data: { "auto-submit-target": "clearFiltersInput" } %>
  <%= hidden_field_tag :status, params[:status] %>
  <%= f.hidden_field :s, value: params.dig(:q, :s).to_s %>
<% end %>
