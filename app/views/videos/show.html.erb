<% content_for :title, @video.title || "Video Analysis" %>

<%= turbo_stream_from @video %>

<div class="min-h-screen bg-base-100">
  <div class="mx-auto p-4 max-w-screen-2xl">
    <!-- Back Link -->
    <div class="mb-6 flex items-center justify-between">
      <%= link_to public_videos_path, class: "btn btn-ghost btn-sm gap-2" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      <% end %>

      <% if user_signed_in? && current_user == @video.user %>
        <%= link_to video_path(@video), data: { turbo_method: :delete, turbo_confirm: "Delete this video analysis?" }, class: "btn btn-ghost btn-sm text-error" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>

    <!-- 2-column layout on xl screens, stacked on smaller -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">
      <!-- Video Embed (left column — 8/12 on xl) -->
      <div class="xl:col-span-8">
        <div class="xl:sticky xl:top-4">
          <div class="card bg-base-200 shadow-xl">
            <div class="card-body p-0">
              <div class="aspect-video w-full">
                <iframe src="<%= @video.embed_url %>" title="<%= @video.title %>"
                        class="w-full h-full rounded-t-2xl"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
              </div>
              <div class="p-4">
                <h1 class="text-xl font-bold mb-1"><%= @video.title %></h1>
                <% if @video.author_name.present? %>
                  <p class="text-base-content/60 text-sm">by <%= @video.author_name %></p>
                <% end %>
                <div class="flex items-center gap-3 mt-2 text-sm text-base-content/50">
                  <span>Submitted by <%= @video.user.username %></span>
                  <span>&middot;</span>
                  <span><%= time_ago_in_words(@video.created_at) %> ago</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Results Section (right column — 4/12 on xl) -->
      <div class="xl:col-span-4">
        <div id="video_results">
          <%= render "results", video: @video, selected_brand: @brand, alternatives: @alternatives %>
        </div>
      </div>
    </div>
  </div>
</div>
