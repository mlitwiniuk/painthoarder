<% if video.pending? || video.processing? %>
  <%= render "videos/processing", video: video %>
<% elsif video.failed? %>
  <div class="card bg-error/10 border border-error/30">
    <div class="card-body text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-error mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <h3 class="text-lg font-semibold text-error mb-1">Analysis Failed</h3>
      <p class="text-base-content/70 text-sm mb-4"><%= video.error_message %></p>
      <p class="text-base-content/50 text-xs">Refresh the page to retry.</p>
    </div>
  </div>
<% elsif video.completed? %>
  <div class="card bg-base-200 shadow-xl">
    <div class="card-body">
      <div class="flex items-center justify-between mb-4">
        <h2 class="card-title">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
          Paints Found (<%= video.video_paints.count %>)
        </h2>
        <div class="flex gap-2 text-sm">
          <span class="badge badge-success badge-sm"><%= video.matched_paints_count %> matched</span>
          <% if video.unmatched_paints_count > 0 %>
            <span class="badge badge-warning badge-sm"><%= video.unmatched_paints_count %> unmatched</span>
          <% end %>
        </div>
      </div>

      <% if video.video_paints.matched.any? %>
        <!-- Brand Alternative Selector -->
        <div class="mb-4" data-controller="video-alternatives" data-video-alternatives-video-path-value="<%= video_path(video) %>">
          <label class="label text-sm font-medium">Find alternatives from:</label>
          <select class="select select-bordered select-sm w-full"
                  data-video-alternatives-target="brandSelect"
                  data-action="change->video-alternatives#selectBrand">
            <option value="">-- Original paints --</option>
            <% Brand.order(:name).each do |brand| %>
              <option value="<%= brand.slug %>" <%= "selected" if local_assigns[:selected_brand] == brand %>><%= brand.name %></option>
            <% end %>
          </select>
        </div>
      <% end %>

      <% alternatives = local_assigns[:alternatives] || {} %>

      <% if video.video_paints.any? %>
        <div class="divide-y divide-base-300">
          <% video.video_paints.includes(paint: { product_line: :brand }).order(:created_at).each do |video_paint| %>
            <%= render "videos/video_paint", video_paint: video_paint, video: video, alternatives: alternatives[video_paint.id] %>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-base-content/60 py-8">No paints were identified in this video.</p>
      <% end %>

      <% if respond_to?(:user_signed_in?) && request&.env&.key?("warden") && !user_signed_in? %>
        <div class="text-center mt-4">
          <p class="text-base-content/50 text-sm">
            <%= link_to "Sign in", new_user_session_path, class: "link link-primary" %> to add paints to your collection.
          </p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
