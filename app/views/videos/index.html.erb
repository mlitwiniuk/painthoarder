<% content_for :title, "My Videos" %>

<div class="min-h-screen bg-base-100">
  <div class="sticky top-0 z-30 bg-base-100/95 backdrop-blur-md border-b border-base-200">
    <div class="navbar px-4">
      <div class="navbar-start">
        <h1 class="text-xl font-bold">Video Analysis</h1>
      </div>

      <div class="navbar-center">
        <div class="tabs tabs-boxed bg-base-200">
          <%= link_to videos_path, class: "tab tab-sm tab-active" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <span class="hidden sm:inline">Mine</span>
          <% end %>
          <%= link_to public_videos_path, class: "tab tab-sm" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9v-9m0-9v9" />
            </svg>
            <span class="hidden sm:inline">All</span>
          <% end %>
        </div>
      </div>

      <div class="navbar-end">
        <%= link_to new_video_path, class: "btn btn-primary btn-circle", title: "Analyze a Video" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>

  <div class="max-w-6xl mx-auto p-4">
    <% if @videos.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @videos.each do |video| %>
          <%= render "video_card", video: video, show_status: true %>
        <% end %>
      </div>

      <div class="mt-8 flex justify-center">
        <%== pagy_nav(@pagy) %>
      </div>
    <% else %>
      <div class="text-center py-16 px-4">
        <div class="max-w-sm mx-auto">
          <div class="mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-base-content mb-2">No videos yet</h3>
          <p class="text-base-content/70 mb-6 text-sm">
            Paste a YouTube painting tutorial URL to extract the paint list.
          </p>
          <%= link_to new_video_path, class: "btn btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Analyze Your First Video
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
