<% content_for :title, "Catalogue | PaintHoarder" %>

<div class="flex flex-col gap-6">
  <div class="flex flex-wrap justify-between items-end gap-4">
    <h1 class="page-title">Catalogue</h1>
    <nav aria-label="Catalogue view" class="cond flex gap-1 font-extrabold text-[17px] tracking-[.03em]">
      <%= link_to "Paints", paints_path, aria: {current: "page"}, class: "no-underline px-4 py-2.5 rounded bg-neutral text-neutral-content" %>
      <%= link_to "Brands & ranges", brands_path, class: "no-underline px-4 py-2 rounded border-2 border-line-strong hover:border-base-content" %>
    </nav>
  </div>

  <%= form_with url: paints_path, method: :get, id: "catalogue-filters",
        data: {controller: "auto-submit", turbo_frame: "catalog-results", turbo_action: "advance"} do %>
    <label class="flex items-center gap-3 px-4 h-[60px] bg-base-100 border-2 border-line-strong rounded focus-within:border-base-content">
      <%= ph_icon(:search, size: 22, css: "text-muted shrink-0") %>
      <span class="sr-only">Search all paints</span>
      <%= search_field_tag :search, params[:search],
            placeholder: "Search #{number_with_delimiter(@total_paints)} paints from #{@total_brands} brands",
            autocomplete: "off",
            class: "w-full bg-transparent border-0 outline-none text-lg",
            data: {action: "input->auto-submit#debouncedSubmit"} %>
    </label>
  <% end %>

  <%= turbo_frame_tag "catalog-results", data: {turbo_action: "advance"} do %>
    <%= render "paints/catalog_results" %>
  <% end %>
</div>
