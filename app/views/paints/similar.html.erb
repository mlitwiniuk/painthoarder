<%= turbo_frame_tag "similar-paints-frame-#{@strategy}" do %>
  <% selected_ids = Array(@brand_ids).map(&:to_s) %>
  <% chip_brands = (@brands.select { |b| selected_ids.include?(b.id.to_s) } + @similar_paints.map { |up| up.paint.product_line.brand }).uniq.first(8) %>
  <% chip_path = ->(ids) { similar_paint_path(@source_paint, similar_type: @strategy, per_page: @per_page, brand_ids: ids.any? ? ids.join(",") : "all", format: :html) } %>
  <% on_rack, others = @similar_paints.partition { |up| !up.virtual? && up.persisted? && up.status == "owned" } %>

  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap justify-between items-center gap-3">
      <p class="text-sm text-soft max-w-xl">
        <% if @strategy == "color" %>
          Ranked by how close the colour looks (CIEDE2000 ΔE). Finish and coverage can still differ.
        <% else %>
          Paints in the same hue family, nearest first.
        <% end %>
        <%= pluralize(@total_count, "match") %> within range.
      </p>
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter by brand">
        <%= link_to "All brands", chip_path.call([]), class: "chip", aria: {pressed: selected_ids.empty?.to_s} %>
        <% chip_brands.each do |brand| %>
          <% on = selected_ids.include?(brand.id.to_s) %>
          <%= link_to brand.name, chip_path.call(on ? selected_ids - [brand.id.to_s] : selected_ids + [brand.id.to_s]),
                class: "chip", aria: {pressed: on.to_s} %>
        <% end %>
      </div>
    </div>

    <% if @similar_paints.any? %>
      <% if on_rack.any? %>
        <span class="eyebrow">On your rack</span>
        <ul class="flex flex-col">
          <% on_rack.each do |user_paint| %>
            <%= render "paints/swap_row", user_paint: user_paint, source: @source_paint, score: @scores[user_paint.paint_id], strategy: @strategy %>
          <% end %>
        </ul>
      <% end %>
      <span class="eyebrow <%= 'hidden' if others.empty? %>"><%= on_rack.any? ? "Not on your rack" : "Closest matches" %></span>
      <ul id="swap-list-<%= @strategy %>" class="flex flex-col">
        <% others.each do |user_paint| %>
          <%= render "paints/swap_row", user_paint: user_paint, source: @source_paint, score: @scores[user_paint.paint_id], strategy: @strategy %>
        <% end %>
      </ul>

      <%= render "paints/similar_load_more" %>
    <% else %>
      <div class="panel-dashed px-6 py-10 flex flex-col items-start gap-2">
        <h3 class="cond font-black text-3xl leading-none">No Close Matches Found</h3>
        <p class="text-soft max-w-xl">
          <% if selected_ids.any? %>
            No paints close enough to <%= @source_paint.name %> in the selected brands. Try widening your brand filter.
          <% else %>
            No paints in the catalogue are close enough to <%= @source_paint.name %>
            <%= @strategy == "color" ? "by colour distance" : "in this hue family" %>. Try the other tab.
          <% end %>
        </p>
        <% if selected_ids.any? %>
          <%= link_to "Show all brands", chip_path.call([]), class: "btn btn-outline btn-sm mt-2" %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
