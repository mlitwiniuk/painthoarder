<%# "Load more": append the next page and swap the pager. %>
<%= turbo_stream.append "catalog-grid" do %>
  <% @catalog_user_paints.each do |user_paint| %>
    <%= render "paints/modern_catalog_card", user_paint: user_paint %>
  <% end %>
<% end %>
<%= turbo_stream.replace "catalog-pager", partial: "paints/catalog_pager" %>
