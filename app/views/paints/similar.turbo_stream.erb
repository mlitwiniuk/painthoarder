<% if @similar_paints.any? %>
  <%= turbo_stream.append "swap-list-#{@strategy}" do %>
    <% @similar_paints.each do |user_paint| %>
      <%= render "paints/swap_row", user_paint: user_paint, source: @source_paint, score: @scores[user_paint.paint_id], strategy: @strategy %>
    <% end %>
  <% end %>
<% end %>
<%= turbo_stream.replace "load-more-#{@strategy}", partial: "paints/similar_load_more" %>
