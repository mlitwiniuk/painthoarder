<div id="collection-options-<%= paint.id %>">
  <h3 class="text-lg font-semibold mb-3">Collection Options</h3>

  <% if user_paint.nil? %>
    <!-- Add to Collection Form -->
    <div class="space-y-4">
      <%= form_with model: UserPaint.new, url: user_paints_path, method: :post, class: "space-y-4" do |f| %>
        <%= f.hidden_field :paint_id, value: paint.id %>

        <div class="form-control">
          <label class="label">
            <span class="label-text font-medium">Add to Your Collection</span>
          </label>
          <div class="join w-full">
            <% UserPaint.statuses.keys.each do |status| %>
              <input class="join-item btn flex-1" type="radio" name="user_paint[status]" value="<%= status %>" aria-label="<%= status.capitalize %>" <%= 'checked' if status == 'owned' %> />
            <% end %>
          </div>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Purchase Date (Optional)</span>
          </label>
          <%= f.date_field :purchase_date, class: "input input-bordered" %>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Purchase Price (Optional)</span>
          </label>
          <%= f.number_field :purchase_price, step: 0.01, class: "input input-bordered", placeholder: "0.00" %>
        </div>

        <div class="form-control">
          <label class="label">
            <span class="label-text">Notes (Optional)</span>
          </label>
          <%= f.text_area :notes, class: "textarea textarea-bordered h-24", placeholder: "Add any notes about this paint..." %>
        </div>

        <%= f.submit "Add to Collection", class: "btn btn-primary btn-block" %>
      <% end %>
    </div>
  <% else %>
    <!-- Already in Collection -->
    <div class="space-y-3">
      <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
        <span class="text-base-content/70">Status</span>
        <span class="font-medium capitalize"><%= user_paint.status %></span>
      </div>

      <% if user_paint.owned? %>
        <% if user_paint.purchase_date.present? %>
          <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
            <span class="text-base-content/70">Purchased</span>
            <span class="font-medium"><%= user_paint.purchase_date.strftime("%b %d, %Y") %></span>
          </div>
        <% end %>
        <% if user_paint.purchase_price.present? %>
          <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
            <span class="text-base-content/70">Price Paid</span>
            <span class="font-medium"><%= number_to_currency(user_paint.purchase_price) %></span>
          </div>
        <% end %>
      <% end %>

      <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
        <span class="text-base-content/70">Added</span>
        <span class="font-medium"><%= time_ago_in_words(user_paint.created_at) %> ago</span>
      </div>

      <!-- Quick Actions -->
      <div class="flex gap-2 pt-2">
        <%= link_to user_paint_path(user_paint), class: "btn btn-outline btn-sm flex-1" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
          View Details
        <% end %>
        <%= link_to edit_user_paint_path(user_paint), data: { turbo_frame: "modal" }, class: "btn btn-ghost btn-sm" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
          </svg>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
