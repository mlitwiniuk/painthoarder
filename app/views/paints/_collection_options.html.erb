<%# Status control for a paint page. Replaced in place by
    paints/collection_status.turbo_stream and user_paints/create.turbo_stream. %>
<% user_paint = local_assigns[:user_paint] %>
<% in_rack = user_paint.present? && user_paint.persisted? && !user_paint.virtual? %>
<% current = in_rack ? user_paint.status : "none" %>
<% options = [["owned", "Owned", :check], ["wishlist", "Wanted", :heart], ["avoid", "Avoid", :ban], ["none", "Not mine", nil]] %>
<% selected_classes = {
     "owned" => "bg-neutral text-neutral-content",
     "wishlist" => "bg-base-200 text-wanted shadow-[inset_0_0_0_2px_var(--color-wanted)]",
     "avoid" => "bg-base-200 text-avoid shadow-[inset_0_0_0_2px_var(--color-avoid)]",
     "none" => "bg-base-200 text-base-content"
   } %>
<% callouts = {
     "owned" => ["On your rack", "Put it back. You already have it."],
     "wishlist" => ["Not on your rack", "It's on your wishlist, so go ahead."],
     "avoid" => ["You marked it Avoid", "Tried it, never again."],
     "none" => ["Not on your rack", "Mark it Wanted to put it on your shopping list."]
   } %>

<div id="collection-options-<%= paint.id %>" class="flex flex-col gap-5">
  <% if user_signed_in? %>
    <% title, body = callouts[current] %>
    <div class="lg:hidden flex gap-3 items-center p-3.5 rounded border-2 <%= {"owned" => "border-base-content", "wishlist" => "border-wanted", "avoid" => "border-avoid"}.fetch(current, "border-line-strong") %>">
      <% if (icon = options.to_h { |v, _l, i| [v, i] }[current]) %>
        <%= ph_icon(icon, size: 26, stroke: 2.6, css: {"wishlist" => "text-wanted", "avoid" => "text-avoid"}.fetch(current, "")) %>
      <% end %>
      <span class="flex flex-col gap-0.5"><b class="text-base"><%= title %></b><span class="text-sm text-soft"><%= body %></span></span>
    </div>

    <div role="group" aria-label="On your rack" class="hidden lg:grid grid-cols-4 border-2 border-line-strong rounded overflow-hidden">
      <% options.each_with_index do |(value, label, icon), index| %>
        <% selected = current == value %>
        <%= button_to collection_status_paint_path(paint), method: :patch, params: {status: value},
              form: {class: "flex #{'border-l-2 border-line-strong' if index.positive?}"},
              aria: {pressed: selected.to_s},
              class: "cond w-full h-14 flex items-center justify-center gap-1.5 font-extrabold text-lg tracking-[.04em] cursor-pointer #{selected ? selected_classes[value] : (value == 'none' ? 'text-muted hover:bg-base-200' : 'hover:bg-base-200')}" do %>
          <%= ph_icon(icon, size: 16, stroke: 3) if icon %><%= label %>
        <% end %>
      <% end %>
    </div>

    <% if in_rack %>
      <% details = [] %>
      <% details << "bought #{user_paint.purchase_date.strftime("%-d %b %Y")}" if user_paint.purchase_date.present? %>
      <% details << number_to_currency(user_paint.purchase_price, unit: "") if user_paint.purchase_price.present? %>
      <div class="panel px-4 py-4 flex flex-col gap-1.5">
        <div class="flex justify-between items-center gap-3">
          <b class="text-[15px]"><%= ([status_label(current)] + details).join(" · ") %></b>
          <%= link_to "Edit details", edit_user_paint_path(user_paint), class: "text-link text-sm", data: {turbo_frame: "modal"} %>
        </div>
        <% if user_paint.notes.present? %>
          <span class="text-sm text-soft whitespace-pre-line">“<%= user_paint.notes %>”</span>
        <% elsif details.empty? %>
          <span class="text-sm text-muted">No notes or purchase details yet.</span>
        <% end %>
      </div>
    <% end %>

    <%# Phone: the status action sits at the thumb, above the tab bar %>
    <div class="lg:hidden fixed inset-x-0 bottom-16 z-30 bg-base-100 border-t-2 border-line px-4 pt-3 pb-3 flex flex-col gap-2.5">
      <% if current == "owned" %>
        <%= link_to "Edit details", edit_user_paint_path(user_paint), class: "btn btn-outline w-full", data: {turbo_frame: "modal"} %>
      <% else %>
        <%= button_to collection_status_paint_path(paint), method: :patch, params: {status: "owned"},
              form: {class: "w-full"}, class: "btn btn-primary w-full" do %>
          <%= ph_icon(:check, size: 18, stroke: 3) %>Bought it, add to rack
        <% end %>
      <% end %>
      <div role="group" aria-label="Status" class="grid grid-cols-3 gap-2">
        <% options.drop(1).each do |value, label, icon| %>
          <% selected = current == value %>
          <%= button_to collection_status_paint_path(paint), method: :patch, params: {status: value},
                form: {class: "flex"}, aria: {pressed: selected.to_s},
                class: "cond w-full h-11 flex items-center justify-center gap-1 rounded border-2 font-extrabold text-[15px] tracking-[.04em] #{selected ? ({"wishlist" => "border-wanted text-wanted", "avoid" => "border-avoid text-avoid"}[value] || "border-base-content") : 'border-line-strong text-soft'}" do %>
            <%= ph_icon(icon, size: 14, stroke: 3) if icon %><%= label %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="panel px-4 py-4 flex flex-wrap items-center justify-between gap-3">
      <span class="text-sm text-soft">Track it as owned, wanted or avoid.</span>
      <div class="flex gap-2">
        <%= link_to "Sign in", new_user_session_path, class: "btn btn-outline btn-sm" %>
        <%= link_to "Join free", new_user_registration_path, class: "btn btn-primary btn-sm" %>
      </div>
    </div>
  <% end %>
</div>
