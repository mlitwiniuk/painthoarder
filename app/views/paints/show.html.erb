<% content_for :title, "#{@paint.name} | PaintHoarder" %>

<div class="max-w-7xl mx-auto p-4">
  <!-- Header with Back Navigation -->
  <div class="flex items-center gap-4 mb-6">
    <%= link_to paints_path, class: "btn btn-circle btn-ghost hover:btn-primary" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
    <% end %>
    <div class="flex-1">
      <h1 class="text-2xl font-bold"><%= @paint.name %></h1>
      <p class="text-base-content/60">
        <%= @paint.product_line.brand.name %> • <%= @paint.product_line.name %>
      </p>
    </div>
  </div>

  <!-- Main Paint Card -->
  <div class="card bg-base-100 shadow-xl border border-base-300 mb-8">
    <!-- Color Hero Section -->
    <div class="relative h-48 sm:h-56 overflow-hidden rounded-t-2xl"
         style="background: linear-gradient(135deg, <%= @paint.hex_color %> 0%, <%= @paint.hex_color %>dd 50%, <%= @paint.hex_color %>88 100%);">

      <!-- Status Badge -->
      <%= render 'status_badge', paint: @paint, user_paint: @user_paint %>

      <!-- Color Information Overlay -->
      <div class="absolute bottom-4 left-4 right-4">
        <div class="bg-base-100/90 backdrop-blur-sm rounded-2xl p-4">
          <div class="grid grid-cols-3 gap-4 text-center">
            <div>
              <div class="text-xs text-base-content/60 font-medium uppercase tracking-wide">HEX</div>
              <div class="font-mono text-sm font-bold"><%= @paint.hex_color %></div>
            </div>
            <div>
              <div class="text-xs text-base-content/60 font-medium uppercase tracking-wide">RGB</div>
              <div class="font-mono text-sm font-bold">
                <%= @paint.red %>, <%= @paint.green %>, <%= @paint.blue %>
              </div>
            </div>
            <div>
              <div class="text-xs text-base-content/60 font-medium uppercase tracking-wide">HSL</div>
              <% h, s, l = rgb_to_hsl(@paint.red, @paint.green, @paint.blue) %>
              <div class="font-mono text-sm font-bold">
                <%= h %>°, <%= s %>%, <%= l %>%
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Paint Details -->
    <div class="card-body">
      <!-- Collection Actions -->
      <% if @user_paint %>
        <div class="flex flex-wrap gap-2 mb-4">
          <%= render 'user_paints/status_actions', user_paint: @user_paint %>
        </div>
      <% end %>

      <!-- Paint Information Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Paint Details -->
        <div>
          <h3 class="text-lg font-semibold mb-3">Paint Details</h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
              <span class="text-base-content/70">Brand</span>
              <span class="font-medium"><%= @paint.product_line.brand.name %></span>
            </div>
            <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
              <span class="text-base-content/70">Product Line</span>
              <span class="font-medium"><%= @paint.product_line.name %></span>
            </div>
            <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
              <span class="text-base-content/70">Color Name</span>
              <span class="font-medium"><%= @paint.name %></span>
            </div>
            <% if @paint.code.present? %>
              <div class="flex justify-between items-center p-3 bg-base-200 rounded-lg">
                <span class="text-base-content/70">Code</span>
                <span class="font-medium"><%= @paint.code %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Collection Options -->
        <div>
          <%= render 'collection_options', paint: @paint, user_paint: @user_paint %>
        </div>
      </div>

      <!-- Notes Section for existing user paint -->
      <%= render 'notes_section', paint: @paint, user_paint: @user_paint %>
    </div>
  </div>

  <!-- Similar Paints Section -->
  <div class="card bg-base-100 shadow-xl border border-base-300">
    <div class="card-body">
      <h2 class="card-title text-2xl mb-6">Similar Paints</h2>

      <!-- Modern Tab Navigation -->
      <div data-controller="similar-tabs">
        <div  class="flex gap-1 bg-base-200 rounded-lg p-1 mb-6 w-fit">
          <button class="px-4 py-2 rounded-md text-sm font-medium transition-all bg-base-100 text-base-content shadow-sm"
                  data-similar-tabs-target="tab"
                  data-tab="rgb"
                  data-action="click->similar-tabs#switch">
            RGB Similarity
          </button>
          <button class="px-4 py-2 rounded-md text-sm font-medium transition-all text-base-content/60 hover:text-base-content"
                  data-similar-tabs-target="tab"
                  data-tab="hsl"
                  data-action="click->similar-tabs#switch">
            HSL Similarity
          </button>
        </div>

        <!-- Tab Content -->
        <div id="rgb-content" class="similar-tab-content" data-similar-tabs-target="content">
          <%= turbo_frame_tag "similar-paints-frame-rgb",
              src: similar_paint_path(@paint, similar_type: "rgb", per_page: 12, format: :html),
              loading: "lazy" do %>
            <div class="flex flex-col items-center justify-center py-12">
              <div class="loading loading-spinner loading-lg text-primary mb-4"></div>
              <p class="text-base-content/60">Loading RGB similar paints...</p>
            </div>
          <% end %>
        </div>

        <div id="hsl-content" class="similar-tab-content hidden" data-similar-tabs-target="content">
          <%= turbo_frame_tag "similar-paints-frame-hsl",
              src: similar_paint_path(@paint, similar_type: "hsl", per_page: 12, format: :html),
              loading: "lazy" do %>
            <div class="flex flex-col items-center justify-center py-12">
              <div class="loading loading-spinner loading-lg text-primary mb-4"></div>
              <p class="text-base-content/60">Loading HSL similar paints...</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
