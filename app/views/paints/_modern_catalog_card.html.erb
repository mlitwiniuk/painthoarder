<%# Catalogue card. `user_paint` is the user's UserPaint or a virtual one. %>
<% paint = user_paint.paint %>
<% line = paint.product_line %>
<% path = directory_paint_path_for(paint) %>
<% in_rack = user_signed_in? && !user_paint.virtual? %>
<article id="paint-card-<%= paint.id %>" class="paint-card">
  <%= link_to "", path, class: "paint-card-swatch block h-28", style: paint_swatch_style(paint),
        aria: {label: "#{paint.name}, #{line.brand.name} #{line.name}"}, data: {turbo_frame: "_top"} %>
  <div class="px-3.5 pt-3 pb-3.5 flex flex-col gap-2 flex-1">
    <div class="flex flex-col gap-1 items-start">
      <span class="tag tag-sm tag-range"><%= line.name %></span>
      <%= link_to paint.name, path, class: "paint-card-name no-underline", data: {turbo_frame: "_top"} %>
      <span class="text-xs text-muted"><%= line.brand.name %></span>
    </div>
    <div class="mt-auto flex items-center justify-between gap-2">
      <span class="font-mono text-[11px] text-muted"><%= paint.hex_color || "Swatch unknown" %></span>
      <% if in_rack %>
        <%= status_tag(user_paint.status) %>
      <% elsif user_signed_in? %>
        <div class="flex items-center gap-1.5">
          <%= button_to collection_status_paint_path(paint), method: :patch, params: {status: "wishlist"},
                class: "w-9 h-9 flex items-center justify-center rounded-[2px] border-2 border-line-strong text-wanted hover:border-wanted cursor-pointer",
                title: "Mark as wanted", aria: {label: "Mark #{paint.name} as wanted"} do %>
            <%= ph_icon(:heart, size: 16, stroke: 2.6) %>
          <% end %>
          <%= button_to collection_status_paint_path(paint), method: :patch, params: {status: "owned"},
                class: "tag tag-add h-9 cursor-pointer hover:border-base-content",
                aria: {label: "Add #{paint.name} to rack as owned"} do %>
            <%= ph_icon(:plus, size: 12, stroke: 3) %>Add
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</article>
