<article id="<%= dom_id project_update %>" class="card bg-base-100 shadow break-inside-avoid">

  <div class="card-body p-4">
    <h3 class="card-title text-base md:text-lg"><%= project_update.title.presence || "Update ##{project_update.position}" %></h3>
    <% if project_update.description.present? %>
      <div class="prose prose-sm max-w-none">
        <%= simple_format(project_update.description) %>
      </div>
    <% end %>

    <%# Paints used %>
    <% if project_update.user_paints.any? %>
      <div class="mt-3 flex flex-wrap gap-1">
        <% project_update.user_paints.limit(10).each do |up| %>
          <span class="badge badge-outline" title="<%= up.paint.name %>"><%= truncate(up.paint.name, length: 20) %></span>
        <% end %>
        <% if project_update.user_paints.count > 10 %>
          <span class="badge badge-ghost">+<%= project_update.user_paints.count - 10 %> more</span>
        <% end %>
      </div>
    <% end %>

    <time class="text-xs text-base-content/60"><%= project_update.created_at.strftime("%b %d, %Y") %></time>

    <% photos = project_update.photos_attachments %>
    <% if photos.any? %>
      <div class="w-full flex flex-wrap gap-1 mb-2">
        <% photos.each do |att| %>
          <%= image_tag att.variant(resize_to_fill: [150,150]), class: "rounded-box h-24 object-cover #{'ring-2 ring-primary' if att == project_update.primary_photo}" %>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
