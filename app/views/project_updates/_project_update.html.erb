<article id="<%= dom_id project_update %>" class="card bg-base-100 shadow-lg hover:shadow-xl transition-all duration-300 break-inside-avoid border border-base-200/50">
  <div class="card-body p-0">
    <!-- Photos Section -->
    <% photos = project_update.photos_attachments %>
    <% if photos.any? %>
      <div data-controller="lightbox" class="relative">
        <% if photos.count == 1 %>
          <!-- Single photo -->
          <figure class="relative group cursor-pointer">
            <%= image_tag photos.first.variant(resize_to_fill: [600,400]),
                class: "w-full h-48 md:h-56 object-cover",
                data: {
                  lightbox_target: "thumbnail",
                  action: "click->lightbox#open",
                  full_url: url_for(photos.first)
                } %>
            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
            <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <div class="bg-black/50 text-white px-2 py-1 rounded-full text-xs">
                Click to expand
              </div>
            </div>
          </figure>
        <% elsif photos.count == 2 %>
          <!-- Two photos side by side -->
          <div class="grid grid-cols-2 gap-0.5">
            <% photos.each do |photo| %>
              <figure class="relative group cursor-pointer">
                <%= image_tag photo.variant(resize_to_fill: [300,300]),
                    class: "w-full h-32 md:h-40 object-cover",
                    data: {
                      lightbox_target: "thumbnail",
                      action: "click->lightbox#open",
                      full_url: url_for(photo)
                    } %>
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
              </figure>
            <% end %>
          </div>
        <% elsif photos.count == 3 %>
          <!-- Three photos: one large, two small -->
          <div class="grid grid-cols-2 gap-0.5 h-48 md:h-56">
            <figure class="relative group cursor-pointer">
              <%= image_tag photos.first.variant(resize_to_fill: [400,400]),
                  class: "w-full h-full object-cover",
                  data: {
                    lightbox_target: "thumbnail",
                    action: "click->lightbox#open",
                    full_url: url_for(photos.first)
                  } %>
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
            </figure>
            <div class="grid grid-rows-2 gap-0.5">
              <% photos[1..2].each do |photo| %>
                <figure class="relative group cursor-pointer">
                  <%= image_tag photo.variant(resize_to_fill: [200,200]),
                      class: "w-full h-full object-cover",
                      data: {
                        lightbox_target: "thumbnail",
                        action: "click->lightbox#open",
                        full_url: url_for(photo)
                      } %>
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
                </figure>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- Four or more photos: show first 3 + overlay -->
          <div class="grid grid-cols-2 gap-0.5 h-48 md:h-56">
            <figure class="relative group cursor-pointer">
              <%= image_tag photos.first.variant(resize_to_fill: [400,400]),
                  class: "w-full h-full object-cover",
                  data: {
                    lightbox_target: "thumbnail",
                    action: "click->lightbox#open",
                    full_url: url_for(photos.first)
                  } %>
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
            </figure>
            <div class="grid grid-rows-2 gap-0.5">
              <figure class="relative group cursor-pointer">
                <%= image_tag photos[1].variant(resize_to_fill: [200,200]),
                    class: "w-full h-full object-cover",
                    data: {
                      lightbox_target: "thumbnail",
                      action: "click->lightbox#open",
                      full_url: url_for(photos[1])
                    } %>
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
              </figure>
              <figure class="relative group cursor-pointer">
                <%= image_tag photos[2].variant(resize_to_fill: [200,200]),
                    class: "w-full h-full object-cover",
                    data: {
                      lightbox_target: "thumbnail",
                      action: "click->lightbox#open",
                      full_url: url_for(photos[2])
                    } %>
                <div class="absolute inset-0 bg-black/50 group-hover:bg-black/60 transition-colors duration-300 flex items-center justify-center">
                  <span class="text-white font-bold text-lg">
                    +<%= photos.count - 3 %>
                  </span>
                </div>
              </figure>
            </div>
          </div>
        <% end %>

        <!-- Primary photo indicator -->
        <% if project_update.primary_photo && photos.include?(project_update.primary_photo) %>
          <div class="absolute top-3 left-3">
            <div class="badge badge-primary badge-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
              Featured
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Content Section -->
    <div class="p-4 space-y-3">
      <!-- Header -->
      <div class="flex items-start justify-between">
        <div class="flex-1 min-w-0">
          <h3 class="font-semibold text-base-content text-lg leading-tight">
            <%= project_update.title.presence || "Update ##{project_update.position}" %>
          </h3>
          <time class="text-sm text-base-content/60 flex items-center gap-1 mt-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <%= project_update.created_at.strftime("%b %d, %Y") %>
          </time>
        </div>

        <!-- Photo count badge -->
        <% if photos.any? %>
          <div class="badge badge-ghost badge-sm gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <%= photos.count %>
          </div>
        <% end %>
      </div>

      <!-- Description -->
      <% if project_update.description.present? %>
        <div class="prose prose-sm max-w-none text-base-content/80">
          <%= simple_format(project_update.description) %>
        </div>
      <% end %>

      <!-- Paints Section -->
      <% if project_update.user_paints.any? %>
        <div class="space-y-2">
          <div class="flex items-center gap-1 text-sm font-medium text-base-content/70">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4 4 4 0 004-4V5z" />
            </svg>
            Paints Used
          </div>
          <div class="flex flex-wrap gap-1">
            <% project_update.user_paints.limit(8).each do |up| %>
              <span class="badge badge-outline badge-sm hover:badge-primary transition-colors cursor-pointer"
                    title="<%= up.paint.name %>">
                <%= truncate(up.paint.name, length: 18) %>
              </span>
            <% end %>
            <% if project_update.user_paints.count > 8 %>
              <span class="badge badge-ghost badge-sm">
                +<%= project_update.user_paints.count - 8 %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Engagement Row -->
      <div class="flex items-center justify-between pt-2 border-t border-base-200">
        <div class="flex items-center gap-4 text-sm text-base-content/60">
          <!-- Future: Like button -->
          <button class="flex items-center gap-1 hover:text-error transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
            <span class="hidden sm:inline">Like</span>
          </button>

          <!-- Future: Comment button -->
          <button class="flex items-center gap-1 hover:text-info transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            <span class="hidden sm:inline">Comment</span>
          </button>
        </div>

        <!-- Share button -->
        <button class="flex items-center gap-1 text-sm text-base-content/60 hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
          </svg>
          <span class="hidden sm:inline">Share</span>
        </button>
      </div>
    </div>
  </div>
</article>
